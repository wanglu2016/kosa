namespace Kosa.LibP

/-- 門：果位（異生、預流向、預流、一來向、一來、不還向、不還、阿羅漢向、阿羅漢） -/
inductive «果位值» where
  | «異生» | «預流向» | «預流» | «一來向» | «一來» | «不還向» | «不還» | «阿羅漢向» | «阿羅漢»
  deriving DecidableEq, Repr

/-- 門：生地（生欲界、生初靜慮、生第二靜慮、生第三靜慮、生第四靜慮、生空無邊處、生識無邊處、生無所有處、生非想非非想處） -/
inductive «生地值» where
  | «生欲界» | «生初靜慮» | «生第二靜慮» | «生第三靜慮» | «生第四靜慮» | «生空無邊處» | «生識無邊處» | «生無所有處» | «生非想非非想處»
  deriving DecidableEq, Repr

/-- 門：欲染（未離欲染、異生離欲染、聖者離欲染） -/
inductive «欲染值» where
  | «未離欲染» | «異生離欲染» | «聖者離欲染»
  deriving DecidableEq, Repr

/-- 門：初靜慮染（未離初靜慮染、異生離初靜慮染、聖者離初靜慮染） -/
inductive «初靜慮染值» where
  | «未離初靜慮染» | «異生離初靜慮染» | «聖者離初靜慮染» | «—»
  deriving DecidableEq, Repr

/-- 門：見道依地（依未至、依靜慮中間、依初靜慮、依第二靜慮、依第三靜慮、依第四靜慮） -/
inductive «見道依地值» where
  | «依未至» | «依靜慮中間» | «依初靜慮» | «依第二靜慮» | «依第三靜慮» | «依第四靜慮» | «—»
  deriving DecidableEq, Repr

/-- 一個「世界」：論域 E，以及每個法在各門的取值、各關係。 -/
structure «世界» where
  E : Type
  «果位» : E → «果位值»
  «生地» : E → «生地值»
  «欲染» : E → «欲染值»
  «初靜慮染» : E → «初靜慮染值»
  «見道依地» : E → «見道依地值»
  «成就味初靜慮» : E → Prop
  «成就淨初靜慮» : E → Prop
  «成就無漏初靜慮» : E → Prop
  «成就初靜慮» : E → Prop

/-- 定義：聖者＝非異生 -/
def «聖者» (W : «世界») (x : W.E) : Prop := ¬(W.«果位» x = .«異生»)

/-- 定義：有學＝預流向或預流或一來向或一來或不還向或不還或阿羅漢向 -/
def «有學» (W : «世界») (x : W.E) : Prop := (W.«果位» x = .«預流向» ∨ W.«果位» x = .«預流» ∨ W.«果位» x = .«一來向» ∨ W.«果位» x = .«一來» ∨ W.«果位» x = .«不還向» ∨ W.«果位» x = .«不還» ∨ W.«果位» x = .«阿羅漢向»)

/-- 定義：無學＝阿羅漢 -/
def «無學» (W : «世界») (x : W.E) : Prop := W.«果位» x = .«阿羅漢»

/-- 定義：已離欲染＝異生離欲染或聖者離欲染 -/
def «已離欲染» (W : «世界») (x : W.E) : Prop := (W.«欲染» x = .«異生離欲染» ∨ W.«欲染» x = .«聖者離欲染»)

/-- 定義：已離初靜慮染＝異生離初靜慮染或聖者離初靜慮染 -/
def «已離初靜慮染» (W : «世界») (x : W.E) : Prop := (W.«初靜慮染» x = .«異生離初靜慮染» ∨ W.«初靜慮染» x = .«聖者離初靜慮染»)

/-- 定義：生色界＝生初靜慮或生第二靜慮或生第三靜慮或生第四靜慮 -/
def «生色界» (W : «世界») (x : W.E) : Prop := (W.«生地» x = .«生初靜慮» ∨ W.«生地» x = .«生第二靜慮» ∨ W.«生地» x = .«生第三靜慮» ∨ W.«生地» x = .«生第四靜慮»)

/-- 定義：生無色界＝生空無邊處或生識無邊處或生無所有處或生非想非非想處 -/
def «生無色界» (W : «世界») (x : W.E) : Prop := (W.«生地» x = .«生空無邊處» ∨ W.«生地» x = .«生識無邊處» ∨ W.«生地» x = .«生無所有處» ∨ W.«生地» x = .«生非想非非想處»)

/-- 定義：生二定以上＝生第二靜慮或生第三靜慮或生第四靜慮或生無色界 -/
def «生二定以上» (W : «世界») (x : W.E) : Prop := (W.«生地» x = .«生第二靜慮» ∨ W.«生地» x = .«生第三靜慮» ∨ W.«生地» x = .«生第四靜慮» ∨ «生無色界» W x)

/-- 本體公理：適用條件、關係的類型約束、對稱。 -/
structure «本體公理» (W : «世界») : Prop where
  «適用_初靜慮染» : ∀ x : W.E, W.«初靜慮染» x = .«—» ↔ ¬(«已離欲染» W x)
  «適用_見道依地» : ∀ x : W.E, W.«見道依地» x = .«—» ↔ ¬(«聖者» W x)

/-- 【聖約一】異生 非 聖者離欲染或聖者離初靜慮染 -/
def «聖約一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«果位» x = .«異生» → ¬((W.«欲染» x = .«聖者離欲染» ∨ W.«初靜慮染» x = .«聖者離初靜慮染»))))

/-- 【聖約二】聖者離欲染 非 異生離初靜慮染 -/
def «聖約二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«欲染» x = .«聖者離欲染» → ¬(W.«初靜慮染» x = .«異生離初靜慮染»)))

/-- 【聖假一】不還 唯 已離欲染 -/
def «聖假一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«果位» x = .«不還» → «已離欲染» W x))

/-- 【聖假二】預流向或預流或一來向或一來 非 已離欲染 -/
def «聖假二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«預流向» ∨ W.«果位» x = .«預流» ∨ W.«果位» x = .«一來向» ∨ W.«果位» x = .«一來») → ¬(«已離欲染» W x)))

/-- 【聖假三】異生 非 成就無漏初靜慮 -/
def «聖假三» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«果位» x = .«異生» → ¬(W.«成就無漏初靜慮» x)))

/-- 【聖定一】預流向或預流或一來向或一來 非 生色界或生無色界 -/
def «聖定一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«預流向» ∨ W.«果位» x = .«預流» ∨ W.«果位» x = .«一來向» ∨ W.«果位» x = .«一來») → ¬((«生色界» W x ∨ «生無色界» W x))))

/-- 【智假一】聖者離初靜慮染 唯 成就無漏初靜慮 -/
def «智假一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«初靜慮染» x = .«聖者離初靜慮染» → W.«成就無漏初靜慮» x))

/-- 【智假二】不還・依未至・異生離欲染 唯 成就無漏初靜慮 -/
def «智假二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«不還» ∧ W.«見道依地» x = .«依未至» ∧ W.«欲染» x = .«異生離欲染») → W.«成就無漏初靜慮» x))

/-- 【智假三】依初靜慮或依靜慮中間或依第二靜慮或依第三靜慮或依第四靜慮 唯 成就無漏初靜慮 -/
def «智假三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«見道依地» x = .«依初靜慮» ∨ W.«見道依地» x = .«依靜慮中間» ∨ W.«見道依地» x = .«依第二靜慮» ∨ W.«見道依地» x = .«依第三靜慮» ∨ W.«見道依地» x = .«依第四靜慮») → W.«成就無漏初靜慮» x))

/-- 【智假四】聖者離欲染 唯 成就無漏初靜慮 -/
def «智假四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«欲染» x = .«聖者離欲染» → W.«成就無漏初靜慮» x))

/-- 【智定一】不還 唯 成就無漏初靜慮 -/
def «智定一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«果位» x = .«不還» → W.«成就無漏初靜慮» x))

/-- 【靜約一】成就初靜慮 即 成就味初靜慮或成就淨初靜慮或成就無漏初靜慮 -/
def «靜約一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«成就初靜慮» x ↔ (W.«成就味初靜慮» x ∨ W.«成就淨初靜慮» x ∨ W.«成就無漏初靜慮» x)))

/-- 【靜假一】生色界或生無色界 唯 已離欲染 -/
def «靜假一» (W : «世界») : Prop :=
  (∀ x : W.E, ((«生色界» W x ∨ «生無色界» W x) → «已離欲染» W x))

/-- 【靜假二】生二定以上 唯 已離初靜慮染 -/
def «靜假二» (W : «世界») : Prop :=
  (∀ x : W.E, («生二定以上» W x → «已離初靜慮染» W x))

/-- 【靜假三】凡 p：生欲界(p) 且 已離欲染(p) ⇒ 成就淨初靜慮(p) -/
def «靜假三» (W : «世界») : Prop :=
  (∀ p : W.E, ((W.«生地» p = .«生欲界» ∧ «已離欲染» W p) → W.«成就淨初靜慮» p))

/-- 【靜假四】生初靜慮 唯 成就淨初靜慮 -/
def «靜假四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«生地» x = .«生初靜慮» → W.«成就淨初靜慮» x))

/-- 【靜假五】生二定以上 非 成就淨初靜慮 -/
def «靜假五» (W : «世界») : Prop :=
  (∀ x : W.E, («生二定以上» W x → ¬(W.«成就淨初靜慮» x)))

/-- 【靜假六】已離初靜慮染 非 成就味初靜慮 -/
def «靜假六» (W : «世界») : Prop :=
  (∀ x : W.E, («已離初靜慮染» W x → ¬(W.«成就味初靜慮» x)))

/-- 【靜假七】非已離初靜慮染 唯 成就味初靜慮 -/
def «靜假七» (W : «世界») : Prop :=
  (∀ x : W.E, (¬(«已離初靜慮染» W x) → W.«成就味初靜慮» x))

/-- 【靜定一】不還・非生二定以上 唯 成就淨初靜慮 -/
def «靜定一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«不還» ∧ ¬(«生二定以上» W x)) → W.«成就淨初靜慮» x))

/-- 【靜定二】不還・生二定以上 唯 成就無漏初靜慮 -/
def «靜定二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«不還» ∧ «生二定以上» W x) → W.«成就無漏初靜慮» x))

/-- 【靜定三】異生・生二定以上 非 成就初靜慮 -/
def «靜定三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«果位» x = .«異生» ∧ «生二定以上» W x) → ¬(W.«成就初靜慮» x)))

/-- 【靜定四】阿那含 唯 成就初靜慮 -/
def «靜定四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«果位» x = .«不還» → W.«成就初靜慮» x))

end Kosa.LibP


/-!
# 模組六的證明：阿那含必然成就初靜慮

論域是補特伽羅。`W.«果位» p = .«不還»` 讀作「p 是不還（阿那含）」，
`W.«成就淨初靜慮» p` 讀作「p 成就淨初靜慮」。

注意：目標所依的假定中，智假二（先離欲染、依未至入見道而證不還者成就無漏初靜慮）
狀態是「待核」。Lean 證明的是「若這些假定成立，則目標成立」；假定本身的真假，Lean 不管。
-/

namespace Kosa.LibP

/-- 不還是聖者（不是異生）。 -/
theorem «不還是聖者» (W : «世界») (p : W.E) (h : W.«果位» p = .«不還») : «聖者» W p := by
  intro hYi
  rw [h] at hYi
  cases hYi

/-- 【靜定一】生在欲界或初靜慮的不還，成就淨初靜慮。依：聖假一、靜假三、靜假四。 -/
theorem «靜定一成立» (W : «世界») (a1 : «聖假一» W) (a5 : «靜假三» W) (a6 : «靜假四» W) :
    «靜定一» W := by
  intro p ⟨hBu, hNot⟩
  cases h : W.«生地» p
  case «生欲界» => exact a5 p ⟨h, a1 p hBu⟩      -- 生欲界：此生離欲染而得（靜假三）
  case «生初靜慮» => exact a6 p h               -- 生初靜慮（靜假四）
  all_goals                                    -- 其餘各地都是二定以上，與前提相違
    exfalso
    apply hNot
    simp [«生二定以上», «生無色界», h]

/-- 【靜定二】生在第二靜慮以上的不還，成就無漏初靜慮。
    依：靜假二、智假一、智假二、智假三、聖約二。 -/
theorem «靜定二成立» (W : «世界») (O : «本體公理» W)
    (a4 : «靜假二» W) (a11 : «智假一» W) (a12 : «智假二» W) (a13 : «智假三» W)
    (k3 : «聖約二» W) : «靜定二» W := by
  intro p ⟨hBu, hUp⟩
  rcases a4 p hUp with hYi | hSheng            -- 已離初靜慮染（靜假二）：作異生時，或作聖者時
  · -- 作異生時已離初靜慮染：看入見道依何地
    have hYu : «已離欲染» W p := by            -- 有初靜慮染之分，必已離欲染（本體）
      cases hw : W.«欲染» p
      case «未離欲染» =>
        have h := (O.«適用_初靜慮染» p).2 (by simp [«已離欲染», hw])
        rw [hYi] at h
        cases h
      case «異生離欲染» => exact Or.inl hw
      case «聖者離欲染» => exact Or.inr hw
    cases hd : W.«見道依地» p
    case «依未至» =>
      rcases hYu with hYY | hSY
      · exact a12 p ⟨hBu, hd, hYY⟩             -- 先離欲染、依未至（智假二，待核）
      · exact absurd hYi (k3 p hSY)            -- 作聖者時才離欲染，不可能先已離初靜慮染（聖約二）
    case «依初靜慮» => exact a13 p (Or.inl hd)
    case «依靜慮中間» => exact a13 p (Or.inr (Or.inl hd))
    case «依第二靜慮» => exact a13 p (Or.inr (Or.inr (Or.inl hd)))
    case «依第三靜慮» => exact a13 p (Or.inr (Or.inr (Or.inr (Or.inl hd))))
    case «依第四靜慮» => exact a13 p (Or.inr (Or.inr (Or.inr (Or.inr hd))))
    case «—» =>                                 -- 聖者必有見道依地
      exact absurd ((O.«適用_見道依地» p).1 hd) (by simp [«不還是聖者» W p hBu])
  · exact a11 p hSheng                          -- 作聖者時離初靜慮染（智假一）

/-- 【靜定三】生在第二靜慮以上的異生，不成就初靜慮。依：靜假二、靜假五、靜假六、聖假三、靜約一。 -/
theorem «靜定三成立» (W : «世界») (a4 : «靜假二» W) (a7 : «靜假五» W) (a8 : «靜假六» W)
    (a10 : «聖假三» W) (k1 : «靜約一» W) : «靜定三» W := by
  intro p ⟨hYi, hUp⟩ hCheng
  rcases (k1 p).1 hCheng with h | h | h
  · exact a8 p (a4 p hUp) h                    -- 味：已離初靜慮染，不成就（靜假六）
  · exact a7 p hUp h                           -- 淨：易地而捨（靜假五）
  · exact a10 p hYi h                          -- 無漏：異生不成就（聖假三）

/-- 【聖定一】預流、一來（及其向）不生上二界。依：聖假二、靜假一。 -/
theorem «聖定一成立» (W : «世界») (a2 : «聖假二» W) (a3 : «靜假一» W) : «聖定一» W :=
  fun p hPre hUp => a2 p hPre (a3 p hUp)

/-- 【智定一】不還都成就無漏初靜慮（若智假二成立）。依：聖假一、智假二、智假三、智假四。 -/
theorem «智定一成立» (W : «世界») (O : «本體公理» W)
    (a1 : «聖假一» W) (a12 : «智假二» W) (a13 : «智假三» W) (a14 : «智假四» W) :
    «智定一» W := by
  intro p hBu
  rcases a1 p hBu with hYY | hSY
  · cases hd : W.«見道依地» p
    case «依未至» => exact a12 p ⟨hBu, hd, hYY⟩
    case «依初靜慮» => exact a13 p (Or.inl hd)
    case «依靜慮中間» => exact a13 p (Or.inr (Or.inl hd))
    case «依第二靜慮» => exact a13 p (Or.inr (Or.inr (Or.inl hd)))
    case «依第三靜慮» => exact a13 p (Or.inr (Or.inr (Or.inr (Or.inl hd))))
    case «依第四靜慮» => exact a13 p (Or.inr (Or.inr (Or.inr (Or.inr hd))))
    case «—» => exact absurd ((O.«適用_見道依地» p).1 hd) (by simp [«不還是聖者» W p hBu])
  · exact a14 p hSY

/-- 【靜定四】阿那含必然成就初靜慮。依：靜定一、靜定二、靜約一。 -/
theorem «靜定四成立» (W : «世界») (d1 : «靜定一» W) (d2 : «靜定二» W) (k1 : «靜約一» W) :
    «靜定四» W := by
  intro p hBu
  apply (k1 p).2
  cases h : W.«生地» p                         -- 就他生在哪一地分情況
  case «生欲界» =>                              -- 生欲界、初靜慮：淨（靜定一）
    exact Or.inr (Or.inl (d1 p ⟨hBu, by simp [«生二定以上», «生無色界», h]⟩))
  case «生初靜慮» =>
    exact Or.inr (Or.inl (d1 p ⟨hBu, by simp [«生二定以上», «生無色界», h]⟩))
  all_goals                                     -- 生二定以上：無漏（靜定二）
    exact Or.inr (Or.inr (d2 p ⟨hBu, by simp [«生二定以上», «生無色界», h]⟩))

/-- 把主證明拼起來：從九條假定、約定直接到目標。 -/
theorem «靜定四由諸假定» (W : «世界») (O : «本體公理» W) (k1 : «靜約一» W) (k3 : «聖約二» W)
    (a1 : «聖假一» W) (a4 : «靜假二» W) (a5 : «靜假三» W) (a6 : «靜假四» W)
    (a11 : «智假一» W) (a12 : «智假二» W) (a13 : «智假三» W) : «靜定四» W :=
  «靜定四成立» W («靜定一成立» W a1 a5 a6) («靜定二成立» W O a4 a11 a12 a13 k3) k1

/-- 另一條證明：經由智定一，不分生地。 -/
theorem «靜定四_經無漏» (W : «世界») (O : «本體公理» W) (k1 : «靜約一» W)
    (a1 : «聖假一» W) (a12 : «智假二» W) (a13 : «智假三» W) (a14 : «智假四» W) :
    «靜定四» W :=
  fun p hBu => (k1 p).2 (Or.inr (Or.inr («智定一成立» W O a1 a12 a13 a14 p hBu)))

end Kosa.LibP
