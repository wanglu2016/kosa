def «色界繫» (W : «世界») (x : W.E) : Prop := (W.«繫不繫» x = .«初靜慮繫» ∨ W.«繫不繫» x = .«第二靜慮繫» ∨ W.«繫不繫» x = .«第三靜慮繫» ∨ W.«繫不繫» x = .«第四靜慮繫»)

/-- 定義：無色界繫＝空無邊處繫或識無邊處繫或無所有處繫或非想非非想處繫 -/
def «無色界繫» (W : «世界») (x : W.E) : Prop := (W.«繫不繫» x = .«空無邊處繫» ∨ W.«繫不繫» x = .«識無邊處繫» ∨ W.«繫不繫» x = .«無所有處繫» ∨ W.«繫不繫» x = .«非想非非想處繫»)

/-- 定義：二定以上＝第二靜慮繫或第三靜慮繫或第四靜慮繫或無色界繫 -/
def «二定以上» (W : «世界») (x : W.E) : Prop := (W.«繫不繫» x = .«第二靜慮繫» ∨ W.«繫不繫» x = .«第三靜慮繫» ∨ W.«繫不繫» x = .«第四靜慮繫» ∨ «無色界繫» W x)

/-- 本體公理：適用條件、關係的類型約束、對稱。 -/
structure «本體公理» (W : «世界») : Prop where
  «適用_色自性» : ∀ x : W.E, W.«色自性» x = .«—» ↔ ¬(W.«法類» x = .«色»)
  «適用_六識» : ∀ x : W.E, W.«六識» x = .«—» ↔ ¬(W.«法類» x = .«心»)
  «適用_心所自性» : ∀ x : W.E, W.«心所自性» x = .«—» ↔ ¬(W.«法類» x = .«心所»)
  «適用_無為自性» : ∀ x : W.E, W.«無為自性» x = .«—» ↔ ¬(W.«法類» x = .«無為»)
  «適用_五受» : ∀ x : W.E, W.«五受» x = .«—» ↔ ¬(W.«心所自性» x = .«受»)
  «適用_見種» : ∀ x : W.E, W.«見種» x = .«—» ↔ ¬(W.«心所自性» x = .«慧»)
  «適用_無表種» : ∀ x : W.E, W.«無表種» x = .«—» ↔ ¬(W.«色自性» x = .«無表色»)
  «適用_表非表» : ∀ x : W.E, W.«表非表» x = .«—» ↔ ¬((W.«色自性» x = .«色處» ∨ W.«色自性» x = .«聲處»))
  «適用_身表» : ∀ x : W.E, W.«表非表» x = .«身表» → W.«色自性» x = .«色處»
  «適用_語表» : ∀ x : W.E, W.«表非表» x = .«語表» → W.«色自性» x = .«聲處»
  «適用_性由» : ∀ x : W.E, W.«性由» x = .«—» ↔ ¬(¬(W.«性» x = .«無覆無記»))
  «適用_有伺無伺» : ∀ x : W.E, W.«有伺無伺» x = .«—» ↔ ¬(W.«法類» x = .«心»)
  «適用_三世» : ∀ x : W.E, W.«三世» x = .«—» ↔ ¬(«有為» W x)
  «適用_殺生» : ∀ x : W.E, W.«業道» x = .«殺生» → «身業» W x
  «適用_不與取» : ∀ x : W.E, W.«業道» x = .«不與取» → «身業» W x
  «適用_欲邪行» : ∀ x : W.E, W.«業道» x = .«欲邪行» → «身業» W x
  «適用_虛誑語» : ∀ x : W.E, W.«業道» x = .«虛誑語» → «語業» W x
  «適用_離間語» : ∀ x : W.E, W.«業道» x = .«離間語» → «語業» W x
  «適用_麁惡語» : ∀ x : W.E, W.«業道» x = .«麁惡語» → «語業» W x
  «適用_雜穢語» : ∀ x : W.E, W.«業道» x = .«雜穢語» → «語業» W x
  «適用_貪業道» : ∀ x : W.E, W.«業道» x = .«貪業道» → W.«心所自性» x = .«貪»
  «適用_瞋業道» : ∀ x : W.E, W.«業道» x = .«瞋業道» → W.«心所自性» x = .«瞋»
  «適用_邪見業道» : ∀ x : W.E, W.«業道» x = .«邪見業道» → W.«見種» x = .«邪見»
  «適用_離殺生» : ∀ x : W.E, W.«業道» x = .«離殺生» → «身業» W x
  «適用_離不與取» : ∀ x : W.E, W.«業道» x = .«離不與取» → «身業» W x
  «適用_離欲邪行» : ∀ x : W.E, W.«業道» x = .«離欲邪行» → «身業» W x
  «適用_離虛誑語» : ∀ x : W.E, W.«業道» x = .«離虛誑語» → «語業» W x
  «適用_離離間語» : ∀ x : W.E, W.«業道» x = .«離離間語» → «語業» W x
  «適用_離麁惡語» : ∀ x : W.E, W.«業道» x = .«離麁惡語» → «語業» W x
  «適用_離雜穢語» : ∀ x : W.E, W.«業道» x = .«離雜穢語» → «語業» W x
  «適用_無貪業道» : ∀ x : W.E, W.«業道» x = .«無貪業道» → W.«心所自性» x = .«無貪»
  «適用_無瞋業道» : ∀ x : W.E, W.«業道» x = .«無瞋業道» → W.«心所自性» x = .«無瞋»
  «適用_正見業道» : ∀ x : W.E, W.«業道» x = .«正見業道» → «正見» W x
  «適用_定散» : ∀ x : W.E, W.«定散» x = .«—» ↔ ¬(W.«法類» x = .«心»)
  «類型_相應» : ∀ x y : W.E, W.«相應» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_相應» : ∀ x y : W.E, W.«相應» x y → W.«相應» y x
  «類型_剎那等起» : ∀ x y : W.E, W.«剎那等起» x y → (W.«法類» x = .«色») ∧ (W.«法類» y = .«心») ∧ x ≠ y
  «類型_同所依» : ∀ x y : W.E, W.«同所依» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_同所依» : ∀ x y : W.E, W.«同所依» x y → W.«同所依» y x
  «傳遞_同所依» : ∀ x y z : W.E, W.«同所依» x y → W.«同所依» y z → x ≠ z → W.«同所依» x z
  «類型_同所緣» : ∀ x y : W.E, W.«同所緣» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_同所緣» : ∀ x y : W.E, W.«同所緣» x y → W.«同所緣» y x
  «傳遞_同所緣» : ∀ x y z : W.E, W.«同所緣» x y → W.«同所緣» y z → x ≠ z → W.«同所緣» x z
  «類型_同行相» : ∀ x y : W.E, W.«同行相» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_同行相» : ∀ x y : W.E, W.«同行相» x y → W.«同行相» y x
  «傳遞_同行相» : ∀ x y z : W.E, W.«同行相» x y → W.«同行相» y z → x ≠ z → W.«同行相» x z
  «類型_同時» : ∀ x y : W.E, W.«同時» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_同時» : ∀ x y : W.E, W.«同時» x y → W.«同時» y x
  «傳遞_同時» : ∀ x y z : W.E, W.«同時» x y → W.«同時» y z → x ≠ z → W.«同時» x z
  «類型_異熟果» : ∀ x y : W.E, W.«異熟果» x y → («有為» W x) ∧ («有為» W y) ∧ x ≠ y
  «類型_等流果» : ∀ x y : W.E, W.«等流果» x y → («有為» W x) ∧ («有為» W y) ∧ x ≠ y
  «類型_士用果» : ∀ x y : W.E, W.«士用果» x y → («有為» W x) ∧ ((«有為» W y ∨ W.«法類» y = .«無為»)) ∧ x ≠ y
  «類型_增上果» : ∀ x y : W.E, W.«增上果» x y → («有為» W x) ∧ («有為» W y) ∧ x ≠ y
  «類型_離繫果» : ∀ x y : W.E, W.«離繫果» x y → («有為» W x) ∧ (W.«無為自性» y = .«擇滅») ∧ x ≠ y

/-- 【界約一】無漏 即 不繫 -/
def «界約一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«有漏無漏» x = .«無漏» ↔ W.«繫不繫» x = .«不繫»))

/-- 【界約二】無漏 即 道諦或無為 -/
def «界約二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«有漏無漏» x = .«無漏» ↔ («道諦» W x ∨ W.«法類» x = .«無為»)))

/-- 【界約三】有學見或無學見 唯 無漏 -/
def «界約三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«見種» x = .«有學見» ∨ W.«見種» x = .«無學見») → W.«有漏無漏» x = .«無漏»))

/-- 【界約四】世間正見 唯 有漏 -/
def «界約四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«見種» x = .«世間正見» → W.«有漏無漏» x = .«有漏»))

/-- 【界約五】五見 唯 染 -/
def «界約五» (W : «世界») : Prop :=
  (∀ x : W.E, («五見» W x → «染» W x))

/-- 【界假一】道諦 唯 善 -/
def «界假一» (W : «世界») : Prop :=
  (∀ x : W.E, («道諦» W x → W.«性» x = .«善»))

/-- 【界假二】非所斷 即 無漏 -/
def «界假二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«斷非斷» x = .«非所斷» ↔ W.«有漏無漏» x = .«無漏»))

/-- 【界假三】不染或色 非 見所斷 -/
def «界假三» (W : «世界») : Prop :=
  (∀ x : W.E, ((«不染» W x ∨ W.«法類» x = .«色») → ¬(W.«斷非斷» x = .«見所斷»)))

/-- 【界假四】擇滅 唯 善 -/
def «界假四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«無為自性» x = .«擇滅» → W.«性» x = .«善»))

/-- 【界假五】非擇滅或虛空 唯 無覆無記 -/
def «界假五» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«無為自性» x = .«非擇滅» ∨ W.«無為自性» x = .«虛空») → W.«性» x = .«無覆無記»))

/-- 【界假六】二定以上・心 唯 無伺 -/
def «界假六» (W : «世界») : Prop :=
  (∀ x : W.E, ((«二定以上» W x ∧ W.«法類» x = .«心») → W.«有伺無伺» x = .«無伺»))

/-- 【界假七】不善 唯 欲界繫 -/
def «界假七» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性» x = .«不善» → W.«繫不繫» x = .«欲界繫»))

/-- 【界定一】苦諦 即 集諦 -/
def «界定一» (W : «世界») : Prop :=
  (∀ x : W.E, («苦諦» W x ↔ «集諦» W x))

/-- 【界定二】染 唯 有漏 -/
def «界定二» (W : «世界») : Prop :=
  (∀ x : W.E, («染» W x → W.«有漏無漏» x = .«有漏»))

/-- 【根約一】凡 x、y：相應(x，y) ⇔ 同所依(x，y) 且 同所緣(x，y) 且 同行相(x，y) 且 同時(x，y) -/
def «根約一» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y ↔ (W.«同所依» x y ∧ W.«同所緣» x y ∧ W.«同行相» x y ∧ W.«同時» x y)))

/-- 【根假一】凡 x：心(x) 且 染(x) ⇒ 有 y：癡(y) 且 相應(x，y) -/
def «根假一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ «染» W x) → (∃ y : W.E, (W.«心所自性» y = .«癡» ∧ W.«相應» x y))))

/-- 【根假二】凡 x、y：相應(x，y) ⇒ 繫不繫(x)＝繫不繫(y) -/
def «根假二» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«繫不繫» x = W.«繫不繫» y))

/-- 【根假三】心心所・阿羅漢相續・最後剎那 非 等無間緣 -/
def «根假三» (W : «世界») : Prop :=
  (∀ x : W.E, ((«心心所» W x ∧ W.«阿羅漢相續» x ∧ W.«最後剎那» x) → ¬(W.«等無間緣» x)))

/-- 【根假四】凡 x、y：異熟果(x，y) ⇒ 不善(x) 或（善(x) 且 有漏(x)） -/
def «根假四» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«異熟果» x y → (W.«性» x = .«不善» ∨ (W.«性» x = .«善» ∧ W.«有漏無漏» x = .«有漏»))))

/-- 【根假五】凡 x、y：異熟果(x，y) ⇒ 無覆無記(y) -/
def «根假五» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«異熟果» x y → W.«性» y = .«無覆無記»))

/-- 【根假六】凡 x、y：等流果(x，y) ⇒ 性(x)＝性(y) 或（染(x) 且 染(y)） -/
def «根假六» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«等流果» x y → (W.«性» x = W.«性» y ∨ («染» W x ∧ «染» W y))))

/-- 【根假七】凡 x、y：離繫果(x，y) ⇒ 善(x) -/
def «根假七» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«離繫果» x y → W.«性» x = .«善»))

/-- 【根假八】凡 x、y：異熟果(x，y) 或 等流果(x，y) 或 士用果(x，y) 或 增上果(x，y) ⇒ 非（過去(y) 且（現在(x) 或 未來(x)））且 非（現在(y) 且 未來(x)） -/
def «根假八» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«異熟果» x y ∨ W.«等流果» x y ∨ W.«士用果» x y ∨ W.«增上果» x y) → (¬((W.«三世» y = .«過去» ∧ (W.«三世» x = .«現在» ∨ W.«三世» x = .«未來»))) ∧ ¬((W.«三世» y = .«現在» ∧ W.«三世» x = .«未來»)))))

/-- 【根假九】凡 x、y：異熟果(x，y) 或 等流果(x，y) ⇒ 非（現在(x) 且 現在(y)） -/
def «根假九» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«異熟果» x y ∨ W.«等流果» x y) → ¬((W.«三世» x = .«現在» ∧ W.«三世» y = .«現在»))))

/-- 【根假十】凡 x、y：等流果(x，y) ⇒ 非 未來(x) -/
def «根假十» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«等流果» x y → ¬(W.«三世» x = .«未來»)))

/-- 【根假十一】凡 x、y：等流果(x，y) ⇒ 有漏無漏(x)＝有漏無漏(y) -/
def «根假十一» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«等流果» x y → W.«有漏無漏» x = W.«有漏無漏» y))

/-- 【根假十二】凡 x、y：等流果(x，y) 且 有漏(x) ⇒ 繫不繫(x)＝繫不繫(y) -/
def «根假十二» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«等流果» x y ∧ W.«有漏無漏» x = .«有漏») → W.«繫不繫» x = W.«繫不繫» y))

/-- 【根定一】凡 x、y、z：相應(x，y) 且 相應(y，z) 且 x≠z ⇒ 相應(x，z) -/
def «根定一» (W : «世界») : Prop :=
  (∀ x y z : W.E, ((W.«相應» x y ∧ W.«相應» y z ∧ ¬(x = z)) → W.«相應» x z))

/-- 【根定二】凡 x、y：相應(x，y) ⇒ 性(x)＝性(y) -/
def «根定二» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«性» x = W.«性» y))

/-- 【世約一】阿羅漢最後心 即 心・阿羅漢相續・最後剎那 -/
def «世約一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x ↔ (W.«法類» x = .«心» ∧ W.«阿羅漢相續» x ∧ W.«最後剎那» x)))

/-- 【世假一】阿羅漢最後心 唯 無覆無記 -/
def «世假一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → W.«性» x = .«無覆無記»))

/-- 【世假二】阿羅漢最後心 唯 意識 -/
def «世假二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → W.«六識» x = .«意識»))

/-- 【世假三】阿羅漢最後心 唯 散心 -/
def «世假三» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → W.«定散» x = .«散心»))

/-- 【世假四】凡 x、y：阿羅漢最後心(x) 且 相應(x，y) 且 受(y) ⇒ 捨受(y) -/
def «世假四» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«阿羅漢最後心» x ∧ W.«相應» x y ∧ W.«心所自性» y = .«受») → W.«五受» y = .«捨受»))

/-- 【世定一】阿羅漢最後心 非 道諦 -/
def «世定一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → ¬(«道諦» W x)))

/-- 【世定二】阿羅漢最後心 唯 有漏 -/
def «世定二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → W.«有漏無漏» x = .«有漏»))

/-- 【世定三】阿羅漢最後心 唯 苦諦・集諦 -/
def «世定三» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → («苦諦» W x ∧ «集諦» W x)))

/-- 【世定四】阿羅漢最後心 唯 修所斷 -/
def «世定四» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → W.«斷非斷» x = .«修所斷»))

/-- 【世定五】凡 x、y：阿羅漢最後心(x) 且 相應(x，y) ⇒ 苦諦(y) 且 集諦(y) -/
def «世定五» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«阿羅漢最後心» x ∧ W.«相應» x y) → («苦諦» W y ∧ «集諦» W y)))

/-- 【世定六】阿羅漢最後心 唯 集諦・非等無間緣 -/
def «世定六» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → («集諦» W x ∧ ¬(W.«等無間緣» x))))

/-- 【世定七】阿羅漢最後心 唯 意識・散心・無覆無記・有漏・修所斷 -/
def «世定七» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«阿羅漢最後心» x → (W.«六識» x = .«意識» ∧ W.«定散» x = .«散心» ∧ W.«性» x = .«無覆無記» ∧ W.«有漏無漏» x = .«有漏» ∧ W.«斷非斷» x = .«修所斷»)))

/-- 【業約一】不善業道 唯 不善 -/
def «業約一» (W : «世界») : Prop :=
  (∀ x : W.E, («不善業道» W x → W.«性» x = .«不善»))

/-- 【業約二】善業道 唯 善 -/
def «業約二» (W : «世界») : Prop :=
  (∀ x : W.E, («善業道» W x → W.«性» x = .«善»))

/-- 【業假一】心或心所或色 非 勝義成 -/
def «業假一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∨ W.«法類» x = .«心所» ∨ W.«法類» x = .«色») → ¬(W.«性由» x = .«勝義成»)))

/-- 【業假二】自性成 唯 心所 -/
def «業假二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性由» x = .«自性成» → W.«法類» x = .«心所»))

/-- 【業假三】相應成 唯 心心所 -/
def «業假三» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性由» x = .«相應成» → «心心所» W x))

/-- 【業假四】等起成・色 唯 色業 -/
def «業假四» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性由» x = .«等起成» ∧ W.«法類» x = .«色») → «色業» W x))

/-- 【業假十二】等起成 唯 色或心不相應行 -/
def «業假十二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性由» x = .«等起成» → (W.«法類» x = .«色» ∨ W.«法類» x = .«心不相應行»)))

/-- 【業假十三】凡 x：心心所(x) 且 相應成(x) ⇒ 有 y：相應(x，y) 且 自性成(y) 且 性(x)＝性(y) -/
def «業假十三» (W : «世界») : Prop :=
  (∀ x : W.E, ((«心心所» W x ∧ W.«性由» x = .«相應成») → (∃ y : W.E, (W.«相應» x y ∧ W.«性由» y = .«自性成» ∧ W.«性» x = W.«性» y))))

/-- 【業假十四】凡 x、y：相應(x，y) 且 自性成(y) ⇒ 性(x)＝性(y) -/
def «業假十四» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«相應» x y ∧ W.«性由» y = .«自性成») → W.«性» x = W.«性» y))

/-- 【業假五】無表色 唯 有記 -/
def «業假五» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«色自性» x = .«無表色» → «有記» W x))

/-- 【業假六】凡 r：色(r) 且 等起成(r) ⇒ 有 c：剎那等起(r，c) 且 性(r)＝性(c) -/
def «業假六» (W : «世界») : Prop :=
  (∀ r : W.E, ((W.«法類» r = .«色» ∧ W.«性由» r = .«等起成») → (∃ c : W.E, (W.«剎那等起» r c ∧ W.«性» r = W.«性» c))))

/-- 【業假七】凡 r：表色(r) ⇒ 有 c：剎那等起(r，c) -/
def «業假七» (W : «世界») : Prop :=
  (∀ r : W.E, («表色» W r → (∃ c : W.E, W.«剎那等起» r c)))

/-- 【業假八】凡 r、c：剎那等起(r，c) ⇒ 繫不繫(r)＝繫不繫(c) -/
def «業假八» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«繫不繫» r = W.«繫不繫» c))

/-- 【業假九】凡 r、c：表色(r) 且 剎那等起(r，c) ⇒ 有伺(c) -/
def «業假九» (W : «世界») : Prop :=
  (∀ r c : W.E, ((«表色» W r ∧ W.«剎那等起» r c) → W.«有伺無伺» c = .«有伺»))

/-- 【業假十】凡 r、c：剎那等起(r，c) ⇒ 有漏(c) -/
def «業假十» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«有漏無漏» c = .«有漏»))

/-- 【業假十一】凡 r、c：剎那等起(r，c) ⇒ 非 見所斷(c) -/
def «業假十一» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → ¬(W.«斷非斷» c = .«見所斷»)))

/-- 【業假十五】貪業道或瞋業道 唯 修所斷 -/
def «業假十五» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«業道» x = .«貪業道» ∨ W.«業道» x = .«瞋業道») → W.«斷非斷» x = .«修所斷»))

/-- 【業定一】色・非無覆無記 唯 等起成 -/
def «業定一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«色» ∧ ¬(W.«性» x = .«無覆無記»)) → W.«性由» x = .«等起成»))

/-- 【業定二】色・非無覆無記 唯 色業 -/
def «業定二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«色» ∧ ¬(W.«性» x = .«無覆無記»)) → «色業» W x))

/-- 【業定三】有覆無記・色 唯 表色 -/
def «業定三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ W.«法類» x = .«色») → «表色» W x))

/-- 【業定四】欲界繫・有覆無記・表色 無 -/
def «業定四» (W : «世界») : Prop :=
  ¬((∃ x : W.E, (W.«繫不繫» x = .«欲界繫» ∧ W.«性» x = .«有覆無記» ∧ «表色» W x)))

/-- 【業定五】表色 唯 欲界繫或初靜慮繫 -/
def «業定五» (W : «世界») : Prop :=
  (∀ x : W.E, («表色» W x → (W.«繫不繫» x = .«欲界繫» ∨ W.«繫不繫» x = .«初靜慮繫»)))

/-- 【業定六】有覆無記・表色 唯 欲界繫或初靜慮繫 -/
def «業定六» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ «表色» W x) → (W.«繫不繫» x = .«欲界繫» ∨ W.«繫不繫» x = .«初靜慮繫»)))

/-- 【業定七】有覆無記・表色 唯 初靜慮繫 -/
def «業定七» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ «表色» W x) → W.«繫不繫» x = .«初靜慮繫»))

/-- 【業定八】有覆無記・色 唯 初靜慮繫 -/
def «業定八» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ W.«法類» x = .«色») → W.«繫不繫» x = .«初靜慮繫»))

/-- 【眠假一】凡 y：惑(y) 且 欲界繫(y) 且 有覆無記(y) ⇒ 身見(y) 或 邊見(y) 或 （癡(y) 且 有 z：相應(y，z) 且 （身見(z) 或 邊見(z)）） -/
def «眠假一» (W : «世界») : Prop :=
  (∀ y : W.E, ((«惑» W y ∧ W.«繫不繫» y = .«欲界繫» ∧ W.«性» y = .«有覆無記») → (W.«見種» y = .«身見» ∨ W.«見種» y = .«邊見» ∨ (W.«心所自性» y = .«癡» ∧ (∃ z : W.E, (W.«相應» y z ∧ (W.«見種» z = .«身見» ∨ W.«見種» z = .«邊見»)))))))

/-- 【眠假二】惑 唯 所斷 -/
def «眠假二» (W : «世界») : Prop :=
  (∀ x : W.E, («惑» W x → «所斷» W x))

/-- 【眠假三】修所斷・惑 非 五見或疑 -/
def «眠假三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«斷非斷» x = .«修所斷» ∧ «惑» W x) → ¬((«五見» W x ∨ W.«心所自性» x = .«疑»))))

/-- 【眠假四】凡 x、y：相應(x，y) 且 惑(y) 且 見所斷(y) ⇒ 見所斷(x) -/
def «眠假四» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«相應» x y ∧ «惑» W y ∧ W.«斷非斷» y = .«見所斷») → W.«斷非斷» x = .«見所斷»))

/-- 【眠定一】五見 唯 見所斷 -/
def «眠定一» (W : «世界») : Prop :=
  (∀ x : W.E, («五見» W x → W.«斷非斷» x = .«見所斷»))

/-- 【眠定二】欲界繫・有覆無記・心 唯 見所斷 -/
def «眠定二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«繫不繫» x = .«欲界繫» ∧ W.«性» x = .«有覆無記» ∧ W.«法類» x = .«心») → W.«斷非斷» x = .«見所斷»))

end Kosa.Lib


/-!
# 模組五的證明：阿羅漢最後心是苦諦、集諦；相應的心、心所同性

讀法與 Proof4.lean 相同：括號裡是前提，冒號後是結論，`by` 之後是證明步驟。
每條定理的前提，恰好是命題文件裡這條定理的「依」。本體約定（如苦諦、集諦的定義）
在 Lean 裡是展開即得的定義，不必另列。

`W.«阿羅漢最後心» x` 讀作「x 是阿羅漢最後心」。
-/

namespace Kosa.Lib

/-! ## 第一部分：阿羅漢最後心是苦諦、集諦 -/

/-- 【世定一】最後心不是道諦。依：世假一（二無記涅槃）、界假一（道諦唯善）。 -/
theorem «世定一成立» (W : «世界») (a1 : «世假一» W) (a6 : «界假一» W) : «世定一» W := by
  intro x hx hDao
  have h := a6 x hDao          -- 若是道諦，則是善（界假一）
  rw [a1 x hx] at h            -- 但它是無覆無記（世假一）
  cases h                      -- 相違

/-- 一個心若不是道諦，就是有漏：它是有為，而無漏的有為就是道諦。 -/
theorem «心非道諦則有漏» (W : «世界») (x : W.E) (hXin : W.«法類» x = .«心»)
    (hNot : ¬ «道諦» W x) : W.«有漏無漏» x = .«有漏» := by
  cases h : W.«有漏無漏» x with
  | «有漏» => rfl
  | «無漏» =>
      exfalso
      apply hNot
      refine ⟨h, ?_⟩            -- 它是無漏；還要說明它是有為
      intro hWu                  -- 設它是無為
      rw [hXin] at hWu           -- 但它是心
      cases hWu

/-- 【世定二】最後心是有漏。依：世定一、世約一（定義：最後心是心）。 -/
theorem «世定二成立» (W : «世界») (d1 : «世定一» W) (k2 : «世約一» W) : «世定二» W :=
  fun x hx => «心非道諦則有漏» W x ((k2 x).1 hx).1 (d1 x hx)

/-- 【界定一】苦諦、集諦範圍相等。由本體約定（二者都定義為有漏）直接得出。 -/
theorem «界定一成立» (W : «世界») : «界定一» W :=
  fun _ => Iff.rfl

/-- 【世定三】阿羅漢最後心是苦諦、集諦。依：世定二、界定一。 -/
theorem «世定三成立» (W : «世界») (d2 : «世定二» W) (d9 : «界定一» W) : «世定三» W := by
  intro x hx
  have hKu : «苦諦» W x := d2 x hx          -- 有漏，即苦諦（本體約定）
  exact ⟨hKu, (d9 x).1 hKu⟩                 -- 苦諦、集諦範圍相等（界定一）

/-- 目標只依三條：最後心的定義（世約一）、二無記涅槃（世假一）、道諦唯善（界假一）。 -/
theorem «世定三由諸假定» (W : «世界») (k2 : «世約一» W) (a1 : «世假一» W) (a6 : «界假一» W) :
    «世定三» W :=
  «世定三成立» W («世定二成立» W («世定一成立» W a1 a6) k2) («界定一成立» W)

/-- 也可以不用定義：頌「最後意識滅」已說最後心是意識，意識是心。 -/
theorem «世定三_以意識代定義» (W : «世界») (O : «本體公理» W)
    (a1 : «世假一» W) (a2 : «世假二» W) (a6 : «界假一» W) : «世定三» W := by
  intro x hx
  have hXin : W.«法類» x = .«心» := by
    by_cases h : W.«法類» x = .«心»
    · exact h
    · have := (O.«適用_六識» x).2 h                -- 不是心就沒有六識之分
      rw [a2 x hx] at this                         -- 但它是意識
      cases this
  have hLou := «心非道諦則有漏» W x hXin («世定一成立» W a1 a6 x hx)
  exact ⟨hLou, hLou⟩

/-- 【界定二】染污法皆有漏。依：界假一、界假四、界假五。
    無漏的有為法是道諦，道諦是善；無漏的無為法，擇滅是善，非擇滅、虛空是無覆無記——都不是染。 -/
theorem «界定二成立» (W : «世界») (O : «本體公理» W)
    (a1 : «界假一» W) (a4 : «界假四» W) (a5 : «界假五» W) : «界定二» W := by
  intro x hRan
  cases h : W.«有漏無漏» x with
  | «有漏» => rfl
  | «無漏» =>
      exfalso
      have hNot : W.«性» x ≠ .«善» ∧ W.«性» x ≠ .«無覆無記» := by
        rcases hRan with h' | h' <;> (rw [h']; exact ⟨by decide, by decide⟩)
      by_cases hW : W.«法類» x = .«無為»
      · cases hk : W.«無為自性» x with                -- 三無為逐一看
        | «擇滅» => exact hNot.1 (a4 x hk)
        | «非擇滅» => exact hNot.2 (a5 x (Or.inl hk))
        | «虛空» => exact hNot.2 (a5 x (Or.inr hk))
        | «—» => exact ((O.«適用_無為自性» x).1 hk) hW
      · exact hNot.1 (a1 x ⟨h, hW⟩)                   -- 無漏的有為就是道諦

/-! ## 第二部分：相應的心、心所同性（原甲假九） -/

/-- 【根定一】相應可傳遞。依：根約一（相應五義）及本體（四種「同」可傳遞）。 -/
theorem «根定一成立» (W : «世界») (O : «本體公理» W) (k3 : «根約一» W) : «根定一» W := by
  intro x y z ⟨hxy, hyz, hne⟩
  obtain ⟨a1, a2, a3, a4⟩ := (k3 x y).1 hxy     -- x、y 同所依、同所緣、同行相、同時
  obtain ⟨b1, b2, b3, b4⟩ := (k3 y z).1 hyz     -- y、z 亦然
  exact (k3 x z).2 ⟨O.«傳遞_同所依» x y z a1 b1 hne, O.«傳遞_同所緣» x y z a2 b2 hne,
    O.«傳遞_同行相» x y z a3 b3 hne, O.«傳遞_同時» x y z a4 b4 hne⟩

/-- 引理：x 不是無覆無記時，與 x 相應的 y 與 x 同性。 -/
theorem «有記者之相應同性» (W : «世界») (O : «本體公理» W) (d7 : «根定一» W)
    (a10 : «業假一» W) (a11 : «業假十二» W) (a12 : «業假十三» W) (a13 : «業假十四» W)
    (x y : W.E) (hxy : W.«相應» x y) (hx : W.«性» x ≠ .«無覆無記») : W.«性» x = W.«性» y := by
  have hxXin := (O.«類型_相應» x y hxy).1        -- x 是心或心所
  have hyx := O.«對稱_相應» x y hxy
  cases hr : W.«性由» x with                     -- x 的善惡由何而成？
  | «勝義成» =>                                  -- 心、心所非勝義（業假一）
      exact absurd hr (a10 x (by rcases hxXin with h | h; exact Or.inl h; exact Or.inr (Or.inl h)))
  | «等起成» =>                                  -- 等起唯色、不相應行（業假十二）
      exfalso
      rcases a11 x hr with h | h <;> (rcases hxXin with h' | h' <;> (rw [h'] at h; cases h))
  | «自性成» => exact (a13 y x ⟨hyx, hr⟩).symm      -- 與自性成者相應，同其性（業假十四）
  | «相應成» =>                                  -- 有一個同性的自性成者 z 與 x 相應（業假十三）
      obtain ⟨z, hxz, hz, hSame⟩ := a12 x ⟨hxXin, hr⟩
      rw [hSame]
      by_cases h : W.«性» z = W.«性» y
      · exact h
      · have hne : y ≠ z := fun e => h (by rw [e])  -- 若 y 就是 z，二者同性；既不同性，y 不是 z
        exact (a13 y z ⟨d7 y x z ⟨hyx, hxz, hne⟩, hz⟩).symm   -- y 亦與 z 相應（根定一），故同性
  | «—» => exact absurd hx ((O.«適用_性由» x).1 hr)  -- 只有無覆無記才無此門，而 x 不是

/-- 【根定二】相應的心、心所同性。依：根定一、業假一、業假十二、業假十三、業假十四。 -/
theorem «根定二成立» (W : «世界») (O : «本體公理» W) (d7 : «根定一» W)
    (a10 : «業假一» W) (a11 : «業假十二» W) (a12 : «業假十三» W) (a13 : «業假十四» W) :
    «根定二» W := by
  intro x y hxy
  by_cases hx : W.«性» x = .«無覆無記»
  · by_cases hy : W.«性» y = .«無覆無記»
    · rw [hx, hy]                                -- 兩者都是無覆無記
    · exact («有記者之相應同性» W O d7 a10 a11 a12 a13 y x (O.«對稱_相應» x y hxy) hy).symm
  · exact «有記者之相應同性» W O d7 a10 a11 a12 a13 x y hxy hx

/-- 把第二部分拼起來：相應法同性，由相應五義、本體與四條關於四種善的假定推出。 -/
theorem «相應同性由諸假定» (W : «世界») (O : «本體公理» W) (k3 : «根約一» W)
    (a10 : «業假一» W) (a11 : «業假十二» W) (a12 : «業假十三» W) (a13 : «業假十四» W) :
    «根定二» W :=
  «根定二成立» W O («根定一成立» W O k3) a10 a11 a12 a13

/-! ## 順帶證明 -/

/-- 【世定四】最後心是修所斷。依：世定二、界假二、界假三、世假一。 -/
theorem «世定四成立» (W : «世界») (d2 : «世定二» W) (a7 : «界假二» W) (a8 : «界假三» W)
    (a1 : «世假一» W) : «世定四» W := by
  intro x hx
  cases h : W.«斷非斷» x with
  | «修所斷» => rfl
  | «非所斷» =>                  -- 非所斷即無漏（界假二），但它有漏（世定二）
      have hWu := (a7 x).1 h
      rw [d2 x hx] at hWu
      cases hWu
  | «見所斷» =>                  -- 不染非見所斷（界假三），而它無覆無記（世假一），是不染
      exact absurd h (a8 x (Or.inl (Or.inr (a1 x hx))))

/-- 【世定五】與最後心相應的心所，也是苦諦、集諦。依：世假一、根定二、界假一。 -/
theorem «世定五成立» (W : «世界») (O : «本體公理» W)
    (a1 : «世假一» W) (d8 : «根定二» W) (a6 : «界假一» W) : «世定五» W := by
  intro x y ⟨hx, hxy⟩
  have hyXing : W.«性» y = .«無覆無記» := by rw [← d8 x y hxy]; exact a1 x hx   -- 同性
  have hyXin := (O.«類型_相應» x y hxy).2.1                                   -- y 是心或心所
  have hLou : W.«有漏無漏» y = .«有漏» := by
    cases h : W.«有漏無漏» y with
    | «有漏» => rfl
    | «無漏» =>
        exfalso
        have hShan := a6 y ⟨h, by                 -- 若無漏，則是道諦（它是有為），故是善
          intro hWu
          rcases hyXin with h' | h' <;> (rw [h'] at hWu; cases hWu)⟩
        rw [hyXing] at hShan                       -- 但它無覆無記
        cases hShan
  exact ⟨hLou, hLou⟩

/-- 【世定六】最後心是集諦，卻不是等無間緣。依：世定二、根假三、世約一。 -/
theorem «世定六成立» (W : «世界») (d2 : «世定二» W) (a5 : «根假三» W) (k2 : «世約一» W) :
    «世定六» W := by
  intro x hx
  obtain ⟨hXin, hA, hL⟩ := (k2 x).1 hx
  exact ⟨d2 x hx, a5 x ⟨Or.inl hXin, hA, hL⟩⟩

/-- 【世定七】最後心的全貌。依：世假一、世假二、世假三、世定二、世定四。 -/
theorem «世定七成立» (W : «世界») (a1 : «世假一» W) (a2 : «世假二» W) (a3 : «世假三» W)
    (d2 : «世定二» W) (d3 : «世定四» W) : «世定七» W :=
  fun x hx => ⟨a2 x hx, a3 x hx, a1 x hx, d2 x hx, d3 x hx⟩

end Kosa.Lib

/-!
# 模組四的證明：前提體系的每一條定理

## 怎樣讀這個文件（給初次接觸 Lean 的讀者）

每條定理的格式是：

    theorem 名稱 (前提一) (前提二) … : 結論 := by
      證明步驟

* 括號裡的是**前提**。例如 `(a1 : «業假一» W)` 讀作「設業假一在世界 W 中成立，記作 a1」。
  每條定理的前提，恰好就是命題文件裡這條定理的「依」。
* 冒號後面是**結論**。
* `by` 之後是**證明步驟**。Lean 逐步檢查，每一步都必須由前面已有的東西嚴格推出；
  有一步不成立，整個文件就通不過。

證明步驟中常用的幾個詞：

| Lean        | 讀作                                     |
|-------------|------------------------------------------|
| `intro x h` | 「設 x 是任一法，且 h：x 滿足條件」          |
| `obtain ⟨c, h⟩ := …` | 「由……，有一個 c，使得 h」        |
| `have h : P := …` | 「得 P，記作 h」                    |
| `exact …`   | 「這正是要證的」                           |
| `cases h : W.«繫不繫» c` | 「就 c 所繫之地，逐一分情況」     |
| `rw [h]`    | 「用 h 代入」                              |
| `absurd`    | 「兩者相違，此情況不可能」                  |
| `decide`    | 「兩個不同的值不相等，這可以直接判定」        |

符號：`∀` 凡，`∃` 有，`∧` 且，`∨` 或，`¬` 非，`→` 則，`↔` 即。
`W.«性» x = .«有覆無記»` 讀作「x 的性是有覆無記」。
-/

namespace Kosa.Lib

/-! ## 小引理：來自本體的適用條件 -/

/-- 表色必是色：身表唯在色處、語表唯在聲處（值的適用條件），有色自性者必是色。 -/
theorem «表色是色» (W : «世界») (O : «本體公理» W) (x : W.E)
    (h : «表色» W x) : W.«法類» x = .«色» := by
  have hZi : W.«色自性» x ≠ .«—» := by
    rcases h with h | h
    · rw [O.«適用_身表» x h]; decide
    · rw [O.«適用_語表» x h]; decide
  by_cases hx : W.«法類» x = .«色»
  · exact hx
  · exact absurd ((O.«適用_色自性» x).2 hx) hZi

/-- 癡不是見：見種只屬於慧，而癡的自性不是慧。 -/
theorem «癡無見種» (W : «世界») (O : «本體公理» W) (y : W.E)
    (h : W.«心所自性» y = .«癡») : W.«見種» y = .«—» :=
  (O.«適用_見種» y).2 (by rw [h]; decide)

/-- 五見是惑（定義）。 -/
theorem «五見是惑» (W : «世界») (x : W.E) (h : «五見» W x) : «惑» W x :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))

/-- 有伺、有漏的心，唯在欲界或初靜慮：
    有漏則非不繫（界約一）；有伺則非二定以上（界假六）。 -/
theorem «有伺有漏心唯欲界或初靜慮» (W : «世界») (k1 : «界約一» W) (a10 : «界假六» W)
    (c : W.E) (hXin : W.«法類» c = .«心») (hSi : W.«有伺無伺» c = .«有伺»)
    (hLou : W.«有漏無漏» c = .«有漏») :
    W.«繫不繫» c = .«欲界繫» ∨ W.«繫不繫» c = .«初靜慮繫» := by
  have hNotUpper : ¬ «二定以上» W c := by
    intro h2
    have h := a10 c ⟨h2, hXin⟩      -- 若在二定以上，則無伺
    rw [hSi] at h                    -- 但它有伺
    cases h                          -- 相違
  have hNotBuxi : W.«繫不繫» c ≠ .«不繫» := by
    intro h
    have h' := (k1 c).2 h            -- 若不繫，則無漏
    rw [hLou] at h'                  -- 但它有漏
    cases h'                         -- 相違
  cases hk : W.«繫不繫» c                -- 就 c 所繫之地分情況
  all_goals first
    | exact Or.inl rfl               -- 欲界：成立
    | exact Or.inr rfl               -- 初靜慮：成立
    | exact absurd hk hNotBuxi       -- 不繫：不可能
    | exact absurd (show «二定以上» W c by simp [«二定以上», «無色界繫», hk]) hNotUpper
                                     -- 二定以上：不可能

/-! ## 定理 -/

/-- 【業定一】色之善、染，唯由等起而成。依：業假一、業假二、業假三。 -/
theorem «業定一成立» (W : «世界») (O : «本體公理» W)
    (a1 : «業假一» W) (a2 : «業假二» W) (a3 : «業假三» W) : «業定一» W := by
  intro x ⟨hSe, hNotWufu⟩            -- 設 x 是色，且不是無覆無記
  cases h : W.«性由» x with           -- 它的善染由何而成？逐一看
  | «等起成» => rfl                   -- 等起成：正是要證的
  | «勝義成» =>                       -- 勝義成：色非勝義（業假一）
      exact absurd h (a1 x (Or.inr (Or.inr hSe)))
  | «自性成» =>                       -- 自性成：唯心所（業假二），而 x 是色
      have h2 := a2 x h
      rw [hSe] at h2
      cases h2
  | «相應成» =>                       -- 相應成：唯心心所（業假三），而 x 是色
      have h3 := a3 x h
      unfold «心心所» at h3
      rw [hSe] at h3
      rcases h3 with h' | h' <;> cases h'
  | «—» =>                            -- 無此門：只有無覆無記才無此門，而 x 不是
      exact absurd hNotWufu ((O.«適用_性由» x).1 h)

/-- 【業定二】善、染之色唯是業。依：業定一、業假四。 -/
theorem «業定二成立» (W : «世界») (d1 : «業定一» W) (a4 : «業假四» W) : «業定二» W := by
  intro x ⟨hSe, hNot⟩
  exact a4 x ⟨d1 x ⟨hSe, hNot⟩, hSe⟩   -- 等起所成之色是業

/-- 【業定三】有覆無記色唯是表色。依：業定二、業假五。 -/
theorem «業定三成立» (W : «世界») (d2 : «業定二» W) (a5 : «業假五» W) : «業定三» W := by
  intro x ⟨hXing, hSe⟩
  have hYe : «色業» W x := d2 x ⟨hSe, by rw [hXing]; decide⟩   -- 它是業：表或無表
  rcases hYe with h | h
  · exact h                                                -- 是表：成立
  · have hJi := a5 x h                                     -- 是無表：則有記（業假五）
    unfold «有記» at hJi
    rw [hXing] at hJi                                      -- 但它是有覆無記
    rcases hJi with h' | h' <;> cases h'                   -- 相違

/-- 【眠定一】五見唯見所斷。依：眠假二、眠假三。 -/
theorem «眠定一成立» (W : «世界»)
    (a16 : «眠假二» W) (a17 : «眠假三» W) : «眠定一» W := by
  intro x h5
  have hHuo := «五見是惑» W x h5               -- 五見是惑（定義）
  rcases a16 x hHuo with hJian | hXiu        -- 隨眠皆所斷：見所斷或修所斷
  · exact hJian
  · exact absurd (Or.inl h5) (a17 x ⟨hXiu, hHuo⟩)   -- 修所斷離見：相違

/-- 【眠定二】欲界有覆無記心唯見所斷。依：根假一、十三、十四、十五、眠定一、眠假四。 -/
theorem «眠定二成立» (W : «世界») (O : «本體公理» W)
    (a12 : «根假一» W) (a13 : «根定二» W) (a14 : «根假二» W) (a15 : «眠假一» W)
    (d4 : «眠定一» W) (a18 : «眠假四» W) : «眠定二» W := by
  intro c ⟨hYu, hXing, hXin⟩
  -- 染心必與癡相應（根假一）
  obtain ⟨y, hyChi, hcy⟩ := a12 c ⟨hXin, Or.inr hXing⟩
  -- 此癡與心同性、同地（根定二、十四）
  have hyXing : W.«性» y = .«有覆無記» := by rw [← a13 c y hcy]; exact hXing
  have hyYu : W.«繫不繫» y = .«欲界繫» := by rw [← a14 c y hcy]; exact hYu
  have hyHuo : «惑» W y := by unfold «惑»; simp [hyChi]   -- 癡是惑（定義）
  -- 欲界有覆無記隨眠，唯身見、邊見及彼俱癡（眠假一）
  rcases a15 y ⟨hyHuo, hyYu, hyXing⟩ with h | h | ⟨_, z, hyz, hz⟩
  · rw [«癡無見種» W O y hyChi] at h; cases h   -- 它是癡，不是身見
  · rw [«癡無見種» W O y hyChi] at h; cases h   -- 它是癡，不是邊見
  · -- 是與身見或邊見 z 相俱的癡
    have hzWu : «五見» W z := by
      rcases hz with h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
    have hzJian := d4 z hzWu                         -- z 見所斷（眠定一）
    have hyJian := a18 y z ⟨hyz, «五見是惑» W z hzWu, hzJian⟩   -- 故癡見所斷（眠假四）
    exact a18 c y ⟨hcy, hyHuo, hyJian⟩               -- 故心見所斷（眠假四）

/-- 【業定四】欲界無有覆無記表——頌「欲無有覆表，以無等起故」。
    依：定一、假六、假八、定五、假十九。 -/
theorem «業定四成立» (W : «世界») (O : «本體公理» W)
    (d1 : «業定一» W) (a6 : «業假六» W) (a8 : «業假八» W) (d5 : «眠定二» W) (a19 : «業假十一» W) :
    «業定四» W := by
  rintro ⟨r, hrYu, hrXing, hrBiao⟩     -- 設有欲界有覆無記表 r，往下推出矛盾
  have hrSe := «表色是色» W O r hrBiao
  have hrDeng := d1 r ⟨hrSe, by rw [hrXing]; decide⟩            -- r 由等起成（業定一）
  obtain ⟨c, hrc, hSame⟩ := a6 r ⟨hrSe, hrDeng⟩                 -- 有同性的剎那等起心 c（業假六）
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  have hcXing : W.«性» c = .«有覆無記» := by rw [← hSame]; exact hrXing
  have hcYu : W.«繫不繫» c = .«欲界繫» := by rw [← a8 r c hrc]; exact hrYu   -- c 同在欲界（業假八）
  exact a19 r c hrc (d5 c ⟨hcYu, hcXing, hcXin⟩)   -- c 見所斷（眠定二），卻作剎那等起（違業假十一）

/-- 【業定五】表唯在欲界、初靜慮——頌「表唯有伺二」。
    依：假七、假九、假十、假八、假十一、約一。 -/
theorem «業定五成立» (W : «世界») (O : «本體公理» W)
    (a7 : «業假七» W) (a9 : «業假九» W) (a10 : «界假六» W) (a8 : «業假八» W)
    (a11 : «業假十» W) (k1 : «界約一» W) : «業定五» W := by
  intro r hrBiao
  obtain ⟨c, hrc⟩ := a7 r hrBiao                     -- 表必有剎那等起心（業假七）
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  rw [a8 r c hrc]                                    -- 表與心同地（業假八）
  exact «有伺有漏心唯欲界或初靜慮» W k1 a10 c hcXin (a9 r c ⟨hrBiao, hrc⟩) (a11 r c hrc)

/-- 【業定六】有覆無記表唯在欲界、初靜慮。不需要業假七。
    依：定一、假六、假九、假十、假八、假十一、約一。 -/
theorem «業定六成立» (W : «世界») (O : «本體公理» W)
    (d1 : «業定一» W) (a6 : «業假六» W) (a9 : «業假九» W) (a10 : «界假六» W) (a8 : «業假八» W)
    (a11 : «業假十» W) (k1 : «界約一» W) : «業定六» W := by
  intro r ⟨hrXing, hrBiao⟩
  have hrSe := «表色是色» W O r hrBiao
  have hrDeng := d1 r ⟨hrSe, by rw [hrXing]; decide⟩
  obtain ⟨c, hrc, _⟩ := a6 r ⟨hrSe, hrDeng⟩         -- 剎那等起心由業假六給出，不必業假七
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  rw [a8 r c hrc]
  exact «有伺有漏心唯欲界或初靜慮» W k1 a10 c hcXin (a9 r c ⟨hrBiao, hrc⟩) (a11 r c hrc)

/-- 【業定七】有覆無記表唯初靜慮繫。依：業定四、業定六。 -/
theorem «業定七成立» (W : «世界») (d6 : «業定四» W) (d7b : «業定六» W) : «業定七» W := by
  intro r ⟨hrXing, hrBiao⟩
  rcases d7b r ⟨hrXing, hrBiao⟩ with h | h
  · exact absurd ⟨r, h, hrXing, hrBiao⟩ d6        -- 在欲界：與業定四相違
  · exact h                                        -- 在初靜慮：成立

/-- 【業定八】有覆無記色唯初靜慮繫。依：業定三、業定七。 -/
theorem «業定八成立» (W : «世界») (d3 : «業定三» W) (d8 : «業定七» W) : «業定八» W := by
  intro r ⟨hrXing, hrSe⟩
  exact d8 r ⟨hrXing, d3 r ⟨hrXing, hrSe⟩⟩         -- 它是表（業定三），故唯初靜慮繫（業定七）

/-! ## 把整棵樹拼起來：從命題庫的假定、約定直接到業定八 -/

/-- 業定八由諸假定推出。前提是它在命題庫中的全部基礎（業假七不在其中）。
    「相應的心、心所同性」（根定二）不再是假定，而由 Proof5 中的「相應同性由諸假定」從相應五義與四種善推出。
    證明不再寫推理，只是把各條定理按「依」的關係拼接起來。 -/
theorem «業定八由諸假定» (W : «世界») (O : «本體公理» W) (k1 : «界約一» W) (kx : «根約一» W)
    (a1 : «業假一» W) (a2 : «業假二» W) (a3 : «業假三» W) (a4 : «業假四» W) (a5 : «業假五» W)
    (a6 : «業假六» W) (a8 : «業假八» W) (a9 : «業假九» W) (a10 : «界假六» W)
    (a11 : «業假十» W) (a12 : «根假一» W) (a14 : «根假二» W)
    (a15 : «眠假一» W) (a16 : «眠假二» W) (a17 : «眠假三» W) (a18 : «眠假四» W)
    (a19 : «業假十一» W) (b12 : «業假十二» W) (b13 : «業假十三» W) (b14 : «業假十四» W) :
    «業定八» W :=
  let r2 := «相應同性由諸假定» W O kx a1 b12 b13 b14
  let d1 := «業定一成立» W O a1 a2 a3
  let d2 := «業定二成立» W d1 a4
  let d3 := «業定三成立» W d2 a5
  let d4 := «眠定一成立» W a16 a17
  let d5 := «眠定二成立» W O a12 r2 a14 a15 d4 a18
  let d6 := «業定四成立» W O d1 a6 a8 d5 a19
  let d7b := «業定六成立» W O d1 a6 a9 a10 a8 a11 k1
  let d8 := «業定七成立» W d6 d7b
  «業定八成立» W d3 d8

end Kosa.Lib
