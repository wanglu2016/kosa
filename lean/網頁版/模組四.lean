/-- 【界品1】無漏 即 不繫 -/
def «界品1» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«無漏» ↔ W.«繫不繫» x = .«不繫»))

/-- 【界品2】無漏 即 道諦或無為 -/
def «界品2» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«無漏» ↔ («道諦» W x ∨ W.«法類» x = .«無為»)))

/-- 【界品3】有學見或無學見 唯 無漏 -/
def «界品3» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ((W.«見種» x = .«有學見» ∨ W.«見種» x = .«無學見») → W.«有漏無漏» x = .«無漏»))

/-- 【界品4】世間正見 唯 有漏 -/
def «界品4» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«見種» x = .«世間正見» → W.«有漏無漏» x = .«有漏»))

/-- 【界品5】五見 唯 染 -/
def «界品5» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («五見» W x → «染» W x))

/-- 【界品6】道諦 唯 善 -/
def «界品6» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («道諦» W x → W.«性» x = .«善»))

/-- 【界品7】非所斷 即 無漏 -/
def «界品7» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«斷非斷» x = .«非所斷» ↔ W.«有漏無漏» x = .«無漏»))

/-- 【界品8】不染或色 非 見所斷 -/
def «界品8» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ((«不染» W x ∨ W.«法類» x = .«色») → ¬(W.«斷非斷» x = .«見所斷»)))

/-- 【界品9】擇滅 唯 善 -/
def «界品9» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«無為自性» x = .«擇滅» → W.«性» x = .«善»))

/-- 【界品10】非擇滅或虛空 唯 無覆無記 -/
def «界品10» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ((W.«無為自性» x = .«非擇滅» ∨ W.«無為自性» x = .«虛空») → W.«性» x = .«無覆無記»))

/-- 【界品11】二定以上・心 唯 無伺 -/
def «界品11» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ((«二定以上» W x ∧ W.«法類» x = .«心») → W.«有伺無伺» x = .«無伺»))

/-- 【界品12】不善 唯 欲界繫 -/
def «界品12» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«性» x = .«不善» → W.«繫不繫» x = .«欲界繫»))

/-- 【界品13】苦諦 即 集諦 -/
def «界品13» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («苦諦» W x ↔ «集諦» W x))

/-- 【界品14】染 唯 有漏 -/
def «界品14» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («染» W x → W.«有漏無漏» x = .«有漏»))

/-- 【界品15】法：有為、無為 -/
def «界品15» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (True ↔ («有為» W x ∨ W.«法類» x = .«無為»)))

/-- 【界品16】有為、無為 互斥 -/
def «界品16» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ¬((«有為» W x ∧ W.«法類» x = .«無為»)))

/-- 【界品17】有漏 即 有為・非道諦 -/
def «界品17» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«有漏» ↔ («有為» W x ∧ ¬(«道諦» W x))))

/-- 【界品18】法：四諦、虛空、非擇滅 -/
def «界品18» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (True ↔ («四諦» W x ∨ W.«無為自性» x = .«虛空» ∨ W.«無為自性» x = .«非擇滅»)))

/-- 【界品19】虛空或非擇滅 非 四諦 -/
def «界品19» (W : «世界») : Prop :=
  (∀ (x : W.«法»), ((W.«無為自性» x = .«虛空» ∨ W.«無為自性» x = .«非擇滅») → ¬(«四諦» W x)))

/-- 【界品20】非四諦 容有 -/
def «界品20» (W : «世界») : Prop :=
  (∃ (x : W.«法»), ¬(«四諦» W x))

/-- 【界品21】擇滅、非擇滅、虛空 各容有 -/
def «界品21» (W : «世界») : Prop :=
  ((∃ (x : W.«法»), W.«無為自性» x = .«擇滅») ∧ (∃ (x : W.«法»), W.«無為自性» x = .«非擇滅») ∧ (∃ (x : W.«法»), W.«無為自性» x = .«虛空»))

/-- 【界品22】有為：苦諦、集諦、道諦 -/
def «界品22» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («有為» W x ↔ («苦諦» W x ∨ «集諦» W x ∨ «道諦» W x)))

/-- 【界品23】無為：滅諦、虛空、非擇滅 -/
def «界品23» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«法類» x = .«無為» ↔ («滅諦» W x ∨ W.«無為自性» x = .«虛空» ∨ W.«無為自性» x = .«非擇滅»)))

/-- 【界品24】有漏：苦諦、集諦 -/
def «界品24» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«有漏» ↔ («苦諦» W x ∨ «集諦» W x)))

/-- 【界品25】無漏：道諦、滅諦、虛空、非擇滅 -/
def «界品25» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«無漏» ↔ («道諦» W x ∨ «滅諦» W x ∨ W.«無為自性» x = .«虛空» ∨ W.«無為自性» x = .«非擇滅»)))

/-- 【界品26】有漏 唯 苦諦 -/
def «界品26» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«有漏» → «苦諦» W x))

/-- 【界品27】有漏 唯 集諦 -/
def «界品27» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«有漏無漏» x = .«有漏» → «集諦» W x))

/-- 【界品28】十六行相 通 有漏、無漏 -/
def «界品28» (W : «世界») : Prop :=
  ((∀ (x : W.«法»), («十六行相» W x → (W.«有漏無漏» x = .«有漏» ∨ W.«有漏無漏» x = .«無漏»))) ∧ (∃ (x : W.«法»), («十六行相» W x ∧ W.«有漏無漏» x = .«有漏»)) ∧ (∃ (x : W.«法»), («十六行相» W x ∧ W.«有漏無漏» x = .«無漏»)))

/-- 【界品29】色 非 無色界繫 -/
def «界品29» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (W.«法類» x = .«色» → ¬(«無色界繫» W x)))

/-- 【界品30】有為 即 五蘊 -/
def «界品30» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («有為» W x ↔ «五蘊» W x))

/-- 【界品31】五蘊 非 無為 -/
def «界品31» (W : «世界») : Prop :=
  (∀ (x : W.«法»), («五蘊» W x → ¬(W.«法類» x = .«無為»)))

/-- 【界品32】法：五蘊、無為 -/
def «界品32» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (True ↔ («五蘊» W x ∨ W.«法類» x = .«無為»)))

/-- 【界品33】色蘊、受蘊、想蘊、行蘊、識蘊 互斥 -/
def «界品33» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (¬((«色蘊» W x ∧ «受蘊» W x)) ∧ ¬((«色蘊» W x ∧ «想蘊» W x)) ∧ ¬((«色蘊» W x ∧ «行蘊» W x)) ∧ ¬((«色蘊» W x ∧ «識蘊» W x)) ∧ ¬((«受蘊» W x ∧ «想蘊» W x)) ∧ ¬((«受蘊» W x ∧ «行蘊» W x)) ∧ ¬((«受蘊» W x ∧ «識蘊» W x)) ∧ ¬((«想蘊» W x ∧ «行蘊» W x)) ∧ ¬((«想蘊» W x ∧ «識蘊» W x)) ∧ ¬((«行蘊» W x ∧ «識蘊» W x))))

/-- 【界品34】法：眼處、耳處、鼻處、舌處、身處、意處、色處、聲處、香處、味處、觸處、法處 -/
def «界品34» (W : «世界») : Prop :=
  (∀ (x : W.«法»), (True ↔ («眼處» W x ∨ «耳處» W x ∨ «鼻處» W x ∨ «舌處» W x ∨ «身處» W x ∨ «意處» W x ∨ W.«色自性» x = .«色處» ∨ W.«色自性» x = .«聲處» ∨ W.«色自性» x = .«香處» ∨ W.«色自性» x = .«味處» ∨ W.«色自性» x = .«觸處» ∨ «法處» W x)))

