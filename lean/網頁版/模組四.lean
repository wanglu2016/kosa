def «隨眠品21» (W : «世界») : Prop :=
  ((∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«心所自性» x = .«貪»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«心所自性» x = .«慢»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«心所自性» x = .«癡»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«見種» x = .«身見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«見種» x = .«邊見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«見種» x = .«邪見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«見種» x = .«見取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«見種» x = .«戒禁取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見苦所斷» ∧ W.«心所自性» x = .«疑»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«心所自性» x = .«貪»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«心所自性» x = .«慢»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«心所自性» x = .«癡»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«見種» x = .«邪見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«見種» x = .«見取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見集所斷» ∧ W.«心所自性» x = .«疑»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«心所自性» x = .«貪»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«心所自性» x = .«慢»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«心所自性» x = .«癡»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«見種» x = .«邪見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«見種» x = .«見取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見滅所斷» ∧ W.«心所自性» x = .«疑»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«心所自性» x = .«貪»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«心所自性» x = .«慢»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«心所自性» x = .«癡»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«見種» x = .«邪見»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«見種» x = .«見取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«見種» x = .«戒禁取»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«見諦» x = .«見道所斷» ∧ W.«心所自性» x = .«疑»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«斷非斷» x = .«修所斷» ∧ W.«心所自性» x = .«貪»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«斷非斷» x = .«修所斷» ∧ W.«心所自性» x = .«慢»)) ∧ (∃ (x : W.«法»), (W.«界» x = .«無色界» ∧ W.«斷非斷» x = .«修所斷» ∧ W.«心所自性» x = .«癡»)))

/-- 【賢聖品1】異生 非 聖者離欲染或聖者離初靜慮染 -/
def «賢聖品1» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«果位» x = .«異生» → ¬((W.«欲染» x = .«聖者離欲染» ∨ W.«初靜慮染» x = .«聖者離初靜慮染»))))

/-- 【賢聖品2】聖者離欲染 非 異生離初靜慮染 -/
def «賢聖品2» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«欲染» x = .«聖者離欲染» → ¬(W.«初靜慮染» x = .«異生離初靜慮染»)))

/-- 【賢聖品3】不還 唯 已離欲染 -/
def «賢聖品3» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«果位» x = .«不還» → «已離欲染» W x))

/-- 【賢聖品4】預流向或預流或一來向或一來 非 已離欲染 -/
def «賢聖品4» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«預流向» ∨ W.«果位» x = .«預流» ∨ W.«果位» x = .«一來向» ∨ W.«果位» x = .«一來») → ¬(«已離欲染» W x)))

/-- 【賢聖品5】異生 非 成就無漏初靜慮 -/
def «賢聖品5» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«果位» x = .«異生» → ¬(W.«成就無漏初靜慮» x)))

/-- 【賢聖品6】預流向或預流或一來向或一來 非 生色界或生無色界 -/
def «賢聖品6» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«預流向» ∨ W.«果位» x = .«預流» ∨ W.«果位» x = .«一來向» ∨ W.«果位» x = .«一來») → ¬((«生色界» W x ∨ «生無色界» W x))))

/-- 【智品1】聖者離初靜慮染 唯 成就無漏初靜慮 -/
def «智品1» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«初靜慮染» x = .«聖者離初靜慮染» → W.«成就無漏初靜慮» x))

/-- 【智品2】不還・依未至・異生離欲染 唯 成就無漏初靜慮 -/
def «智品2» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«不還» ∧ W.«見道依地» x = .«依未至» ∧ W.«欲染» x = .«異生離欲染») → W.«成就無漏初靜慮» x))

/-- 【智品3】依初靜慮或依靜慮中間或依第二靜慮或依第三靜慮或依第四靜慮 唯 成就無漏初靜慮 -/
def «智品3» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«見道依地» x = .«依初靜慮» ∨ W.«見道依地» x = .«依靜慮中間» ∨ W.«見道依地» x = .«依第二靜慮» ∨ W.«見道依地» x = .«依第三靜慮» ∨ W.«見道依地» x = .«依第四靜慮») → W.«成就無漏初靜慮» x))

/-- 【智品4】聖者離欲染 唯 成就無漏初靜慮 -/
def «智品4» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«欲染» x = .«聖者離欲染» → W.«成就無漏初靜慮» x))

/-- 【智品5】不還 唯 成就無漏初靜慮 -/
def «智品5» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«果位» x = .«不還» → W.«成就無漏初靜慮» x))

/-- 【定品1】成就初靜慮 即 成就味初靜慮或成就淨初靜慮或成就無漏初靜慮 -/
def «定品1» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«成就初靜慮» x ↔ (W.«成就味初靜慮» x ∨ W.«成就淨初靜慮» x ∨ W.«成就無漏初靜慮» x)))

/-- 【定品2】生色界或生無色界 唯 已離欲染 -/
def «定品2» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((«生色界» W x ∨ «生無色界» W x) → «已離欲染» W x))

/-- 【定品3】生二定以上 唯 已離初靜慮染 -/
def «定品3» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), («生二定以上» W x → «已離初靜慮染» W x))

/-- 【定品4】凡 p：生欲界(p) 且 已離欲染(p) ⇒ 成就淨初靜慮(p) -/
def «定品4» (W : «世界») : Prop :=
  (∀ (p : W.«有情»), ((W.«生地» p = .«生欲界» ∧ «已離欲染» W p) → W.«成就淨初靜慮» p))

/-- 【定品5】生初靜慮 唯 成就淨初靜慮 -/
def «定品5» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«生地» x = .«生初靜慮» → W.«成就淨初靜慮» x))

/-- 【定品6】生二定以上 非 成就淨初靜慮 -/
def «定品6» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), («生二定以上» W x → ¬(W.«成就淨初靜慮» x)))

/-- 【定品7】已離初靜慮染 非 成就味初靜慮 -/
def «定品7» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), («已離初靜慮染» W x → ¬(W.«成就味初靜慮» x)))

/-- 【定品8】非已離初靜慮染 唯 成就味初靜慮 -/
def «定品8» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (¬(«已離初靜慮染» W x) → W.«成就味初靜慮» x))

/-- 【定品9】不還・非生二定以上 唯 成就淨初靜慮 -/
def «定品9» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«不還» ∧ ¬(«生二定以上» W x)) → W.«成就淨初靜慮» x))

/-- 【定品10】不還・生二定以上 唯 成就無漏初靜慮 -/
def «定品10» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«不還» ∧ «生二定以上» W x) → W.«成就無漏初靜慮» x))

/-- 【定品11】異生・生二定以上 非 成就初靜慮 -/
def «定品11» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), ((W.«果位» x = .«異生» ∧ «生二定以上» W x) → ¬(W.«成就初靜慮» x)))

/-- 【定品12】阿那含 唯 成就初靜慮 -/
def «定品12» (W : «世界») : Prop :=
  (∀ (x : W.«有情»), (W.«果位» x = .«不還» → W.«成就初靜慮» x))

end Kosa.Lib


/-!
# 模組五的證明：阿羅漢最後心是苦諦、集諦；相應的心、心所同性

讀法與 Proof4.lean 相同：括號裡是前提，冒號後是結論，`by` 之後是證明步驟。
每條定理的前提，恰好是命題文件裡這條定理的「依」。本體約定（如苦諦、集諦的定義）
在 Lean 裡是展開即得的定義，不必另列。

`W.«阿羅漢最後心» x` 讀作「x 是阿羅漢最後心」。
-/

namespace Kosa.Lib

/-! ## 第一部分：阿羅漢最後心是苦諦、集諦 -/

/-- 【世間品6】最後心不是道諦。依：世間品2（二無記涅槃）、界品6（道諦唯善）。 -/
theorem «世間品6成立» (W : «世界») (a1 : «世間品2» W) (a6 : «界品6» W) : «世間品6» W := by
  intro x hx hDao
  have h := a6 x hDao          -- 若是道諦，則是善（界品6）
  rw [a1 x hx] at h            -- 但它是無覆無記（世間品2）
  cases h                      -- 相違

/-- 一個心若不是道諦，就是有漏：它是有為，而無漏的有為就是道諦。 -/
theorem «心非道諦則有漏» (W : «世界») (x : W.«法») (hXin : W.«法類» x = .«心»)
    (hNot : ¬ «道諦» W x) : W.«有漏無漏» x = .«有漏» := by
  cases h : W.«有漏無漏» x with
  | «有漏» => rfl
  | «無漏» =>
      exfalso
      apply hNot
      refine ⟨h, ?_⟩            -- 它是無漏；還要說明它是有為
      intro hWu                  -- 設它是無為
      rw [hXin] at hWu           -- 但它是心
      cases hWu

/-- 【世間品7】最後心是有漏。依：世間品6、世間品1（定義：最後心是心）。 -/
theorem «世間品7成立» (W : «世界») (d1 : «世間品6» W) (k2 : «世間品1» W) : «世間品7» W :=
  fun x hx => «心非道諦則有漏» W x ((k2 x).1 hx).1 (d1 x hx)

/-- 【界品13】苦諦、集諦範圍相等。由本體約定（二者都定義為有漏）直接得出。 -/
theorem «界品13成立» (W : «世界») : «界品13» W :=
  fun _ => Iff.rfl

/-- 【世間品8】阿羅漢最後心是苦諦、集諦。依：世間品7、界品13。 -/
theorem «世間品8成立» (W : «世界») (d2 : «世間品7» W) (d9 : «界品13» W) : «世間品8» W := by
  intro x hx
  have hKu : «苦諦» W x := d2 x hx          -- 有漏，即苦諦（本體約定）
  exact ⟨hKu, (d9 x).1 hKu⟩                 -- 苦諦、集諦範圍相等（界品13）

/-- 目標只依三條：最後心的定義（世間品1）、二無記涅槃（世間品2）、道諦唯善（界品6）。 -/
theorem «世間品8由諸假定» (W : «世界») (k2 : «世間品1» W) (a1 : «世間品2» W) (a6 : «界品6» W) :
    «世間品8» W :=
  «世間品8成立» W («世間品7成立» W («世間品6成立» W a1 a6) k2) («界品13成立» W)

/-- 也可以不用定義：頌「最後意識滅」已說最後心是意識，意識是心。 -/
theorem «世間品8_以意識代定義» (W : «世界») (O : «本體公理» W)
    (a1 : «世間品2» W) (a2 : «世間品3» W) (a6 : «界品6» W) : «世間品8» W := by
  intro x hx
  have hXin : W.«法類» x = .«心» := by
    by_cases h : W.«法類» x = .«心»
    · exact h
    · have := (O.«適用_六識» x).2 h                -- 不是心就沒有六識之分
      rw [a2 x hx] at this                         -- 但它是意識
      cases this
  have hLou := «心非道諦則有漏» W x hXin («世間品6成立» W a1 a6 x hx)
  exact ⟨hLou, hLou⟩

/-- 【界品14】染污法皆有漏。依：界品6、界品9、界品10。
    無漏的有為法是道諦，道諦是善；無漏的無為法，擇滅是善，非擇滅、虛空是無覆無記——都不是染。 -/
theorem «界品14成立» (W : «世界») (O : «本體公理» W)
    (a1 : «界品6» W) (a4 : «界品9» W) (a5 : «界品10» W) : «界品14» W := by
  intro x hRan
  cases h : W.«有漏無漏» x with
  | «有漏» => rfl
  | «無漏» =>
      exfalso
      have hNot : W.«性» x ≠ .«善» ∧ W.«性» x ≠ .«無覆無記» := by
        rcases hRan with h' | h' <;> (rw [h']; exact ⟨by decide, by decide⟩)
      by_cases hW : W.«法類» x = .«無為»
      · cases hk : W.«無為自性» x with                -- 三無為逐一看
        | «擇滅» => exact hNot.1 (a4 x hk)
        | «非擇滅» => exact hNot.2 (a5 x (Or.inl hk))
        | «虛空» => exact hNot.2 (a5 x (Or.inr hk))
        | «—» => exact ((O.«適用_無為自性» x).1 hk) hW
      · exact hNot.1 (a1 x ⟨h, hW⟩)                   -- 無漏的有為就是道諦

/-! ## 第二部分：相應的心、心所同性（原甲假九） -/

/-- 【根品14】相應可傳遞。依：根品1（相應五義）及本體（四種「同」可傳遞）。 -/
theorem «根品14成立» (W : «世界») (O : «本體公理» W) (k3 : «根品1» W) : «根品14» W := by
  intro x y z ⟨hxy, hyz, hne⟩
  obtain ⟨a1, a2, a3, a4⟩ := (k3 x y).1 hxy     -- x、y 同所依、同所緣、同行相、同時
  obtain ⟨b1, b2, b3, b4⟩ := (k3 y z).1 hyz     -- y、z 亦然
  exact (k3 x z).2 ⟨O.«傳遞_同所依» x y z a1 b1 hne, O.«傳遞_同所緣» x y z a2 b2 hne,
    O.«傳遞_同行相» x y z a3 b3 hne, O.«傳遞_同時» x y z a4 b4 hne⟩

/-- 引理：x 不是無覆無記時，與 x 相應的 y 與 x 同性。 -/
theorem «有記者之相應同性» (W : «世界») (O : «本體公理» W) (d7 : «根品14» W)
    (a10 : «業品3» W) (a11 : «業品7» W) (a12 : «業品8» W) (a13 : «業品9» W)
    (x y : W.«法») (hxy : W.«相應» x y) (hx : W.«性» x ≠ .«無覆無記») : W.«性» x = W.«性» y := by
  have hxXin := (O.«類型_相應» x y hxy).1        -- x 是心或心所
  have hyx := O.«對稱_相應» x y hxy
  cases hr : W.«性由» x with                     -- x 的善惡由何而成？
  | «勝義成» =>                                  -- 心、心所非勝義（業品3）
      exact absurd hr (a10 x (by rcases hxXin with h | h; exact Or.inl h; exact Or.inr (Or.inl h)))
  | «等起成» =>                                  -- 等起唯色、不相應行（業品7）
      exfalso
      rcases a11 x hr with h | h <;> (rcases hxXin with h' | h' <;> (rw [h'] at h; cases h))
  | «自性成» => exact (a13 y x ⟨hyx, hr⟩).symm      -- 與自性成者相應，同其性（業品9）
  | «相應成» =>                                  -- 有一個同性的自性成者 z 與 x 相應（業品8）
      obtain ⟨z, hxz, hz, hSame⟩ := a12 x ⟨hxXin, hr⟩
      rw [hSame]
      by_cases h : W.«性» z = W.«性» y
      · exact h
      · have hne : y ≠ z := fun e => h (by rw [e])  -- 若 y 就是 z，二者同性；既不同性，y 不是 z
        exact (a13 y z ⟨d7 y x z ⟨hyx, hxz, hne⟩, hz⟩).symm   -- y 亦與 z 相應（根品14），故同性
  | «—» => exact absurd hx ((O.«適用_性由» x).1 hr)  -- 只有無覆無記才無此門，而 x 不是

/-- 【根品15】相應的心、心所同性。依：根品14、業品3、業品7、業品8、業品9。 -/
theorem «根品15成立» (W : «世界») (O : «本體公理» W) (d7 : «根品14» W)
    (a10 : «業品3» W) (a11 : «業品7» W) (a12 : «業品8» W) (a13 : «業品9» W) :
    «根品15» W := by
  intro x y hxy
  by_cases hx : W.«性» x = .«無覆無記»
  · by_cases hy : W.«性» y = .«無覆無記»
    · rw [hx, hy]                                -- 兩者都是無覆無記
    · exact («有記者之相應同性» W O d7 a10 a11 a12 a13 y x (O.«對稱_相應» x y hxy) hy).symm
  · exact «有記者之相應同性» W O d7 a10 a11 a12 a13 x y hxy hx

/-- 把第二部分拼起來：相應法同性，由相應五義、本體與四條關於四種善的假定推出。 -/
theorem «相應同性由諸假定» (W : «世界») (O : «本體公理» W) (k3 : «根品1» W)
    (a10 : «業品3» W) (a11 : «業品7» W) (a12 : «業品8» W) (a13 : «業品9» W) :
    «根品15» W :=
  «根品15成立» W O («根品14成立» W O k3) a10 a11 a12 a13

/-! ## 順帶證明 -/

/-- 【世間品9】最後心是修所斷。依：世間品7、界品7、界品8、世間品2。 -/
theorem «世間品9成立» (W : «世界») (d2 : «世間品7» W) (a7 : «界品7» W) (a8 : «界品8» W)
    (a1 : «世間品2» W) : «世間品9» W := by
  intro x hx
  cases h : W.«斷非斷» x with
  | «修所斷» => rfl
  | «非所斷» =>                  -- 非所斷即無漏（界品7），但它有漏（世間品7）
      have hWu := (a7 x).1 h
      rw [d2 x hx] at hWu
      cases hWu
  | «見所斷» =>                  -- 不染非見所斷（界品8），而它無覆無記（世間品2），是不染
      exact absurd h (a8 x (Or.inl (Or.inr (a1 x hx))))

/-- 【世間品10】與最後心相應的心所，也是苦諦、集諦。依：世間品2、根品15、界品6。 -/
theorem «世間品10成立» (W : «世界») (O : «本體公理» W)
    (a1 : «世間品2» W) (d8 : «根品15» W) (a6 : «界品6» W) : «世間品10» W := by
  intro x y ⟨hx, hxy⟩
  have hyXing : W.«性» y = .«無覆無記» := by rw [← d8 x y hxy]; exact a1 x hx   -- 同性
  have hyXin := (O.«類型_相應» x y hxy).2.1                                   -- y 是心或心所
  have hLou : W.«有漏無漏» y = .«有漏» := by
    cases h : W.«有漏無漏» y with
    | «有漏» => rfl
    | «無漏» =>
        exfalso
        have hShan := a6 y ⟨h, by                 -- 若無漏，則是道諦（它是有為），故是善
          intro hWu
          rcases hyXin with h' | h' <;> (rw [h'] at hWu; cases hWu)⟩
        rw [hyXing] at hShan                       -- 但它無覆無記
        cases hShan
  exact ⟨hLou, hLou⟩

/-- 【世間品11】最後心是集諦，卻不是等無間緣。依：世間品7、根品4、世間品1。 -/
theorem «世間品11成立» (W : «世界») (d2 : «世間品7» W) (a5 : «根品4» W) (k2 : «世間品1» W) :
    «世間品11» W := by
  intro x hx
  obtain ⟨hXin, hA, hL⟩ := (k2 x).1 hx
  exact ⟨d2 x hx, a5 x ⟨Or.inl hXin, hA, hL⟩⟩

/-- 【世間品12】最後心的全貌。依：世間品2、世間品3、世間品4、世間品7、世間品9。 -/
theorem «世間品12成立» (W : «世界») (a1 : «世間品2» W) (a2 : «世間品3» W) (a3 : «世間品4» W)
    (d2 : «世間品7» W) (d3 : «世間品9» W) : «世間品12» W :=
  fun x hx => ⟨a2 x hx, a3 x hx, a1 x hx, d2 x hx, d3 x hx⟩

end Kosa.Lib

/-!
# 模組四的證明：前提體系的每一條定理

## 怎樣讀這個文件（給初次接觸 Lean 的讀者）

每條定理的格式是：

    theorem 名稱 (前提一) (前提二) … : 結論 := by
      證明步驟

* 括號裡的是**前提**。例如 `(a1 : «業品3» W)` 讀作「設業品3在世界 W 中成立，記作 a1」。
  每條定理的前提，恰好就是命題文件裡這條定理的「依」。
* 冒號後面是**結論**。
* `by` 之後是**證明步驟**。Lean 逐步檢查，每一步都必須由前面已有的東西嚴格推出；
  有一步不成立，整個文件就通不過。

證明步驟中常用的幾個詞：

| Lean        | 讀作                                     |
|-------------|------------------------------------------|
| `intro x h` | 「設 x 是任一法，且 h：x 滿足條件」          |
| `obtain ⟨c, h⟩ := …` | 「由……，有一個 c，使得 h」        |
| `have h : P := …` | 「得 P，記作 h」                    |
| `exact …`   | 「這正是要證的」                           |
| `cases h : W.«繫不繫» c` | 「就 c 所繫之地，逐一分情況」     |
| `rw [h]`    | 「用 h 代入」                              |
| `absurd`    | 「兩者相違，此情況不可能」                  |
| `decide`    | 「兩個不同的值不相等，這可以直接判定」        |

符號：`∀` 凡，`∃` 有，`∧` 且，`∨` 或，`¬` 非，`→` 則，`↔` 即。
`W.«性» x = .«有覆無記»` 讀作「x 的性是有覆無記」。
-/

namespace Kosa.Lib

/-! ## 小引理：來自本體的適用條件 -/

/-- 表色必是色：身表唯在色處、語表唯在聲處（值的適用條件），有色自性者必是色。 -/
theorem «表色是色» (W : «世界») (O : «本體公理» W) (x : W.«法»)
    (h : «表色» W x) : W.«法類» x = .«色» := by
  have hZi : W.«色自性» x ≠ .«—» := by
    rcases h with h | h
    · rw [O.«適用_身表» x h]; decide
    · rw [O.«適用_語表» x h]; decide
  by_cases hx : W.«法類» x = .«色»
  · exact hx
  · exact absurd ((O.«適用_色自性» x).2 hx) hZi

/-- 癡不是見：見種只屬於慧，而癡的自性不是慧。 -/
theorem «癡無見種» (W : «世界») (O : «本體公理» W) (y : W.«法»)
    (h : W.«心所自性» y = .«癡») : W.«見種» y = .«—» :=
  (O.«適用_見種» y).2 (by rw [h]; decide)

/-- 五見是惑（定義）。 -/
theorem «五見是惑» (W : «世界») (x : W.«法») (h : «五見» W x) : «惑» W x :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr h))))

/-- 有伺、有漏的心，唯在欲界或初靜慮：
    有漏則非不繫（界品1）；有伺則非二定以上（界品11）。 -/
theorem «有伺有漏心唯欲界或初靜慮» (W : «世界») (k1 : «界品1» W) (a10 : «界品11» W)
    (c : W.«法») (hXin : W.«法類» c = .«心») (hSi : W.«有伺無伺» c = .«有伺»)
    (hLou : W.«有漏無漏» c = .«有漏») :
    W.«繫不繫» c = .«欲界繫» ∨ W.«繫不繫» c = .«初靜慮繫» := by
  have hNotUpper : ¬ «二定以上» W c := by
    intro h2
    have h := a10 c ⟨h2, hXin⟩      -- 若在二定以上，則無伺
    rw [hSi] at h                    -- 但它有伺
    cases h                          -- 相違
  have hNotBuxi : W.«繫不繫» c ≠ .«不繫» := by
    intro h
    have h' := (k1 c).2 h            -- 若不繫，則無漏
    rw [hLou] at h'                  -- 但它有漏
    cases h'                         -- 相違
  cases hk : W.«繫不繫» c                -- 就 c 所繫之地分情況
  all_goals first
    | exact Or.inl rfl               -- 欲界：成立
    | exact Or.inr rfl               -- 初靜慮：成立
    | exact absurd hk hNotBuxi       -- 不繫：不可能
    | exact absurd (show «二定以上» W c by simp [«二定以上», «無色界繫», hk]) hNotUpper
                                     -- 二定以上：不可能

/-! ## 定理 -/

/-- 【業品18】色之善、染，唯由等起而成。依：業品3、業品4、業品5。 -/
theorem «業品18成立» (W : «世界») (O : «本體公理» W)
    (a1 : «業品3» W) (a2 : «業品4» W) (a3 : «業品5» W) : «業品18» W := by
  intro x ⟨hSe, hNotWufu⟩            -- 設 x 是色，且不是無覆無記
  cases h : W.«性由» x with           -- 它的善染由何而成？逐一看
  | «等起成» => rfl                   -- 等起成：正是要證的
  | «勝義成» =>                       -- 勝義成：色非勝義（業品3）
      exact absurd h (a1 x (Or.inr (Or.inr hSe)))
  | «自性成» =>                       -- 自性成：唯心所（業品4），而 x 是色
      have h2 := a2 x h
      rw [hSe] at h2
      cases h2
  | «相應成» =>                       -- 相應成：唯心心所（業品5），而 x 是色
      have h3 := a3 x h
      unfold «心心所» at h3
      rw [hSe] at h3
      rcases h3 with h' | h' <;> cases h'
  | «—» =>                            -- 無此門：只有無覆無記才無此門，而 x 不是
      exact absurd hNotWufu ((O.«適用_性由» x).1 h)

/-- 【業品19】善、染之色唯是業。依：業品18、業品6。 -/
theorem «業品19成立» (W : «世界») (d1 : «業品18» W) (a4 : «業品6» W) : «業品19» W := by
  intro x ⟨hSe, hNot⟩
  exact a4 x ⟨d1 x ⟨hSe, hNot⟩, hSe⟩   -- 等起所成之色是業

/-- 【業品20】有覆無記色唯是表色。依：業品19、業品10。 -/
theorem «業品20成立» (W : «世界») (d2 : «業品19» W) (a5 : «業品10» W) : «業品20» W := by
  intro x ⟨hXing, hSe⟩
  have hYe : «色業» W x := d2 x ⟨hSe, by rw [hXing]; decide⟩   -- 它是業：表或無表
  rcases hYe with h | h
  · exact h                                                -- 是表：成立
  · have hJi := a5 x h                                     -- 是無表：則有記（業品10）
    unfold «有記» at hJi
    rw [hXing] at hJi                                      -- 但它是有覆無記
    rcases hJi with h' | h' <;> cases h'                   -- 相違

/-- 【隨眠品5】五見唯見所斷。依：隨眠品2、隨眠品3。 -/
theorem «隨眠品5成立» (W : «世界»)
    (a16 : «隨眠品2» W) (a17 : «隨眠品3» W) : «隨眠品5» W := by
  intro x h5
  have hHuo := «五見是惑» W x h5               -- 五見是惑（定義）
  rcases a16 x hHuo with hJian | hXiu        -- 隨眠皆所斷：見所斷或修所斷
  · exact hJian
  · exact absurd (Or.inl h5) (a17 x ⟨hXiu, hHuo⟩)   -- 修所斷離見：相違

/-- 【隨眠品6】欲界有覆無記心唯見所斷。依：根品2、十三、十四、十五、隨眠品5、隨眠品4。 -/
theorem «隨眠品6成立» (W : «世界») (O : «本體公理» W)
    (a12 : «根品2» W) (a13 : «根品15» W) (a14 : «根品3» W) (a15 : «隨眠品1» W)
    (d4 : «隨眠品5» W) (a18 : «隨眠品4» W) : «隨眠品6» W := by
  intro c ⟨hYu, hXing, hXin⟩
  -- 染心必與癡相應（根品2）
  obtain ⟨y, hyChi, hcy⟩ := a12 c ⟨hXin, Or.inr hXing⟩
  -- 此癡與心同性、同地（根品15、十四）
  have hyXing : W.«性» y = .«有覆無記» := by rw [← a13 c y hcy]; exact hXing
  have hyYu : W.«繫不繫» y = .«欲界繫» := by rw [← a14 c y hcy]; exact hYu
  have hyHuo : «惑» W y := by unfold «惑»; simp [hyChi]   -- 癡是惑（定義）
  -- 欲界有覆無記隨眠，唯身見、邊見及彼俱癡（隨眠品1）
  rcases a15 y ⟨hyHuo, hyYu, hyXing⟩ with h | h | ⟨_, z, hyz, hz⟩
  · rw [«癡無見種» W O y hyChi] at h; cases h   -- 它是癡，不是身見
  · rw [«癡無見種» W O y hyChi] at h; cases h   -- 它是癡，不是邊見
  · -- 是與身見或邊見 z 相俱的癡
    have hzWu : «五見» W z := by
      rcases hz with h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inl h')
    have hzJian := d4 z hzWu                         -- z 見所斷（隨眠品5）
    have hyJian := a18 y z ⟨hyz, «五見是惑» W z hzWu, hzJian⟩   -- 故癡見所斷（隨眠品4）
    exact a18 c y ⟨hcy, hyHuo, hyJian⟩               -- 故心見所斷（隨眠品4）

/-- 【業品21】欲界無有覆無記表——頌「欲無有覆表，以無等起故」。
    依：定一、假六、假八、定五、假十九。 -/
theorem «業品21成立» (W : «世界») (O : «本體公理» W)
    (d1 : «業品18» W) (a6 : «業品11» W) (a8 : «業品13» W) (d5 : «隨眠品6» W) (a19 : «業品16» W) :
    «業品21» W := by
  rintro ⟨r, hrYu, hrXing, hrBiao⟩     -- 設有欲界有覆無記表 r，往下推出矛盾
  have hrSe := «表色是色» W O r hrBiao
  have hrDeng := d1 r ⟨hrSe, by rw [hrXing]; decide⟩            -- r 由等起成（業品18）
  obtain ⟨c, hrc, hSame⟩ := a6 r ⟨hrSe, hrDeng⟩                 -- 有同性的剎那等起心 c（業品11）
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  have hcXing : W.«性» c = .«有覆無記» := by rw [← hSame]; exact hrXing
  have hcYu : W.«繫不繫» c = .«欲界繫» := by rw [← a8 r c hrc]; exact hrYu   -- c 同在欲界（業品13）
  exact a19 r c hrc (d5 c ⟨hcYu, hcXing, hcXin⟩)   -- c 見所斷（隨眠品6），卻作剎那等起（違業品16）

/-- 【業品22】表唯在欲界、初靜慮——頌「表唯有伺二」。
    依：假七、假九、假十、假八、假十一、約一。 -/
theorem «業品22成立» (W : «世界») (O : «本體公理» W)
    (a7 : «業品12» W) (a9 : «業品14» W) (a10 : «界品11» W) (a8 : «業品13» W)
    (a11 : «業品15» W) (k1 : «界品1» W) : «業品22» W := by
  intro r hrBiao
  obtain ⟨c, hrc⟩ := a7 r hrBiao                     -- 表必有剎那等起心（業品12）
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  rw [a8 r c hrc]                                    -- 表與心同地（業品13）
  exact «有伺有漏心唯欲界或初靜慮» W k1 a10 c hcXin (a9 r c ⟨hrBiao, hrc⟩) (a11 r c hrc)

/-- 【業品23】有覆無記表唯在欲界、初靜慮。不需要業品12。
    依：定一、假六、假九、假十、假八、假十一、約一。 -/
theorem «業品23成立» (W : «世界») (O : «本體公理» W)
    (d1 : «業品18» W) (a6 : «業品11» W) (a9 : «業品14» W) (a10 : «界品11» W) (a8 : «業品13» W)
    (a11 : «業品15» W) (k1 : «界品1» W) : «業品23» W := by
  intro r ⟨hrXing, hrBiao⟩
  have hrSe := «表色是色» W O r hrBiao
  have hrDeng := d1 r ⟨hrSe, by rw [hrXing]; decide⟩
  obtain ⟨c, hrc, _⟩ := a6 r ⟨hrSe, hrDeng⟩         -- 剎那等起心由業品11給出，不必業品12
  have hcXin := (O.«類型_剎那等起» r c hrc).2.1
  rw [a8 r c hrc]
  exact «有伺有漏心唯欲界或初靜慮» W k1 a10 c hcXin (a9 r c ⟨hrBiao, hrc⟩) (a11 r c hrc)

/-- 【業品24】有覆無記表唯初靜慮繫。依：業品21、業品23。 -/
theorem «業品24成立» (W : «世界») (d6 : «業品21» W) (d7b : «業品23» W) : «業品24» W := by
  intro r ⟨hrXing, hrBiao⟩
  rcases d7b r ⟨hrXing, hrBiao⟩ with h | h
  · exact absurd ⟨r, h, hrXing, hrBiao⟩ d6        -- 在欲界：與業品21相違
  · exact h                                        -- 在初靜慮：成立

/-- 【業品25】有覆無記色唯初靜慮繫。依：業品20、業品24。 -/
theorem «業品25成立» (W : «世界») (d3 : «業品20» W) (d8 : «業品24» W) : «業品25» W := by
  intro r ⟨hrXing, hrSe⟩
  exact d8 r ⟨hrXing, d3 r ⟨hrXing, hrSe⟩⟩         -- 它是表（業品20），故唯初靜慮繫（業品24）

/-! ## 把整棵樹拼起來：從命題庫的假定、約定直接到業品25 -/

/-- 業品25由諸假定推出。前提是它在命題庫中的全部基礎（業品12不在其中）。
    「相應的心、心所同性」（根品15）不再是假定，而由 Proof5 中的「相應同性由諸假定」從相應五義與四種善推出。
    證明不再寫推理，只是把各條定理按「依」的關係拼接起來。 -/
theorem «業品25由諸假定» (W : «世界») (O : «本體公理» W) (k1 : «界品1» W) (kx : «根品1» W)
    (a1 : «業品3» W) (a2 : «業品4» W) (a3 : «業品5» W) (a4 : «業品6» W) (a5 : «業品10» W)
    (a6 : «業品11» W) (a8 : «業品13» W) (a9 : «業品14» W) (a10 : «界品11» W)
    (a11 : «業品15» W) (a12 : «根品2» W) (a14 : «根品3» W)
    (a15 : «隨眠品1» W) (a16 : «隨眠品2» W) (a17 : «隨眠品3» W) (a18 : «隨眠品4» W)
    (a19 : «業品16» W) (b12 : «業品7» W) (b13 : «業品8» W) (b14 : «業品9» W) :
    «業品25» W :=
  let r2 := «相應同性由諸假定» W O kx a1 b12 b13 b14
  let d1 := «業品18成立» W O a1 a2 a3
  let d2 := «業品19成立» W d1 a4
  let d3 := «業品20成立» W d2 a5
  let d4 := «隨眠品5成立» W a16 a17
  let d5 := «隨眠品6成立» W O a12 r2 a14 a15 d4 a18
  let d6 := «業品21成立» W O d1 a6 a8 d5 a19
  let d7b := «業品23成立» W O d1 a6 a9 a10 a8 a11 k1
  let d8 := «業品24成立» W d6 d7b
  «業品25成立» W d3 d8

end Kosa.Lib
