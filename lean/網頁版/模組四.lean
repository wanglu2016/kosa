def «不定地法» (W : «世界») (x : W.E) : Prop := (W.«心所自性» x = .«貪» ∨ W.«心所自性» x = .«瞋» ∨ W.«心所自性» x = .«慢» ∨ W.«心所自性» x = .«疑» ∨ W.«心所自性» x = .«惡作» ∨ W.«心所自性» x = .«睡眠» ∨ W.«心所自性» x = .«尋» ∨ W.«心所自性» x = .«伺»)

/-- 定義：五見＝身見或邊見或邪見或見取或戒禁取 -/
def «五見» (W : «世界») (x : W.E) : Prop := (W.«見種» x = .«身見» ∨ W.«見種» x = .«邊見» ∨ W.«見種» x = .«邪見» ∨ W.«見種» x = .«見取» ∨ W.«見種» x = .«戒禁取»)

/-- 定義：正見＝世間正見或有學見或無學見 -/
def «正見» (W : «世界») (x : W.E) : Prop := (W.«見種» x = .«世間正見» ∨ W.«見種» x = .«有學見» ∨ W.«見種» x = .«無學見»)

/-- 定義：惑＝貪或瞋或慢或疑或癡或五見 -/
def «惑» (W : «世界») (x : W.E) : Prop := (W.«心所自性» x = .«貪» ∨ W.«心所自性» x = .«瞋» ∨ W.«心所自性» x = .«慢» ∨ W.«心所自性» x = .«疑» ∨ W.«心所自性» x = .«癡» ∨ «五見» W x)

/-- 定義：苦諦＝有漏 -/
def «苦諦» (W : «世界») (x : W.E) : Prop := W.«有漏無漏» x = .«有漏»

