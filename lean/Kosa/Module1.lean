  «適用_身表» : ∀ x : W.E, W.«表非表» x = .«身表» → W.«色自性» x = .«色處»
  «適用_語表» : ∀ x : W.E, W.«表非表» x = .«語表» → W.«色自性» x = .«聲處»
  «適用_心所自性» : ∀ x : W.E, W.«心所自性» x = .«—» ↔ ¬(W.«法類» x = .«心所»)
  «適用_見種» : ∀ x : W.E, W.«見種» x = .«—» ↔ ¬(W.«心所自性» x = .«慧»)
