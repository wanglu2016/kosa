  «類型_相應» : ∀ x y : W.E, W.«相應» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_相應» : ∀ x y : W.E, W.«相應» x y → W.«相應» y x
  «類型_剎那等起» : ∀ x y : W.E, W.«剎那等起» x y → (W.«法類» x = .«色») ∧ (W.«法類» y = .«心») ∧ x ≠ y
  «類型_因等起» : ∀ x y : W.E, W.«因等起» x y → (W.«法類» x = .«色») ∧ (W.«法類» y = .«心») ∧ x ≠ y

/-- 【前提1】見所斷・惑 唯 內門轉 -/
def «前提1» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«斷非斷» x = .«見所斷» ∧ «惑» W x) → W.«門轉» x = .«內門轉»))

/-- 【前提2】五見 唯 見所斷 -/
def «前提2» (W : «世界») : Prop :=
  (∀ x : W.E, («五見» W x → W.«斷非斷» x = .«見所斷»))

/-- 【前提3甲】凡 x、y：相應(x，y) ⇒ 斷非斷(x)＝斷非斷(y) -/
def «前提3甲» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«斷非斷» x = W.«斷非斷» y))

/-- 【前提3乙】凡 x、y：相應(x，y) ⇒ 門轉(x)＝門轉(y) -/
def «前提3乙» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«門轉» x = W.«門轉» y))

/-- 【前提4】所斷：見所斷、修所斷 -/
def «前提4» (W : «世界») : Prop :=
  (∀ x : W.E, («所斷» W x ↔ (W.«斷非斷» x = .«見所斷» ∨ W.«斷非斷» x = .«修所斷»)))

/-- 【前提5】心・非所斷 唯 無漏 -/
def «前提5» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ W.«斷非斷» x = .«非所斷») → W.«有漏無漏» x = .«無漏»))

/-- 【前提6】不染・心 非 見所斷 -/
def «前提6» (W : «世界») : Prop :=
  (∀ x : W.E, ((«不染» W x ∧ W.«法類» x = .«心») → ¬(W.«斷非斷» x = .«見所斷»)))

/-- 【前提7】凡 x：心(x) 且 染(x) ⇒ 有 y：心所(y) 且 相應(x，y) 且 性(x)＝性(y) -/
def «前提7» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ «染» W x) → (∃ y : W.E, (W.«法類» y = .«心所» ∧ W.«相應» x y ∧ W.«性» x = W.«性» y))))

/-- 【前提8】凡 r、c：表色(r) 且 剎那等起(r，c) ⇒ 外門轉(c) -/
def «前提8» (W : «世界») : Prop :=
  (∀ r c : W.E, ((«表色» W r ∧ W.«剎那等起» r c) → W.«門轉» c = .«外門轉»))

/-- 【前提9】凡 y：惑(y) 且 欲界繫(y) 且 有覆無記(y) ⇒ 身見(y) 或 邊見(y) 或 （癡(y) 且 有 z：相應(y，z) 且 （身見(z) 或 邊見(z)）） -/
def «前提9» (W : «世界») : Prop :=
  (∀ y : W.E, ((«惑» W y ∧ W.«繫不繫» y = .«欲界繫» ∧ W.«性» y = .«有覆無記») → (W.«見種» y = .«身見» ∨ W.«見種» y = .«邊見» ∨ (W.«心所自性» y = .«癡» ∧ (∃ z : W.E, (W.«相應» y z ∧ (W.«見種» z = .«身見» ∨ W.«見種» z = .«邊見»)))))))

/-- 【前提10甲】凡 r：色(r) 且 非 無覆無記(r) ⇒ 有 c：剎那等起(r，c) 且 性(r)＝性(c) -/
def «前提10甲» (W : «世界») : Prop :=
