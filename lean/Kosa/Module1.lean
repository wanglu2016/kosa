/-- 【前提14】染：不善、有覆無記 -/
def «前提14» (W : «世界») : Prop :=
  (∀ x : W.E, («染» W x ↔ (W.«性» x = .«不善» ∨ W.«性» x = .«有覆無記»)))

/-- 【前提15】無表色 唯 有記 -/
def «前提15» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«色自性» x = .«無表色» → «有記» W x))

/-- 【前提16】惑 唯 所斷 -/
def «前提16» (W : «世界») : Prop :=
  (∀ x : W.E, («惑» W x → «所斷» W x))

/-- 【補一】凡 x：心(x) 且 染(x) ⇒ 有 y：惑(y) 且 相應(x，y) -/
def «補一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ «染» W x) → (∃ y : W.E, («惑» W y ∧ W.«相應» x y))))

/-- 【補二】凡 x、y：相應(x，y) ⇒ 性(x)＝性(y) -/
def «補二» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«性» x = W.«性» y))

/-- 【補三】凡 x、y：相應(x，y) ⇒ 繫不繫(x)＝繫不繫(y) -/
def «補三» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«繫不繫» x = W.«繫不繫» y))

/-- 【補四】凡 r、c：剎那等起(r，c) ⇒ 繫不繫(r)＝繫不繫(c) -/
def «補四» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«繫不繫» r = W.«繫不繫» c))

/-- 【補五】凡 r、c：剎那等起(r，c) ⇒ 有漏(c) -/
def «補五» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«有漏無漏» c = .«有漏»))

/-- 【補六】無漏 即 不繫 -/
def «補六» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«有漏無漏» x = .«無漏» ↔ W.«繫不繫» x = .«不繫»))

/-- 【補七】染 唯 有漏 -/
def «補七» (W : «世界») : Prop :=
  (∀ x : W.E, («染» W x → W.«有漏無漏» x = .«有漏»))

/-- 【補八】無漏 唯 非所斷 -/
def «補八» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«有漏無漏» x = .«無漏» → W.«斷非斷» x = .«非所斷»))

/-- 【補九】凡 r：表色(r) ⇒ 有 c：剎那等起(r，c) -/
def «補九» (W : «世界») : Prop :=
  (∀ r : W.E, («表色» W r → (∃ c : W.E, W.«剎那等起» r c)))

/-- 【頌一】凡 r、c：剎那等起(r，c) ⇒ 非 見所斷(c) -/
def «頌一» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → ¬(W.«斷非斷» c = .«見所斷»)))

/-- 【頌二】表色 唯 欲界繫或初靜慮繫 -/
def «頌二» (W : «世界») : Prop :=
  (∀ x : W.E, («表色» W x → (W.«繫不繫» x = .«欲界繫» ∨ W.«繫不繫» x = .«初靜慮繫»)))

/-- 【頌三】欲界繫・有覆無記・表色 無 -/
def «頌三» (W : «世界») : Prop :=
  ¬((∃ x : W.E, (W.«繫不繫» x = .«欲界繫» ∧ W.«性» x = .«有覆無記» ∧ «表色» W x)))

/-- 【異讀10甲】凡 r：色(r) 且 非 無覆無記(r) ⇒ 有 c：因等起(r，c) 且 性(r)＝性(c) -/
def «異讀10甲» (W : «世界») : Prop :=
  (∀ r : W.E, ((W.«法類» r = .«色» ∧ ¬(W.«性» r = .«無覆無記»)) → (∃ c : W.E, (W.«因等起» r c ∧ W.«性» r = W.«性» c))))

/-- 【異讀8】凡 r、c：表色(r) 且 因等起(r，c) ⇒ 外門轉(c) -/
def «異讀8» (W : «世界») : Prop :=
  (∀ r c : W.E, ((«表色» W r ∧ W.«因等起» r c) → W.«門轉» c = .«外門轉»))

/-- 【異讀補四】凡 r、c：因等起(r，c) ⇒ 繫不繫(r)＝繫不繫(c) -/
def «異讀補四» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«因等起» r c → W.«繫不繫» r = W.«繫不繫» c))

/-- 【異讀補五】凡 r、c：因等起(r，c) ⇒ 有漏(c) -/
def «異讀補五» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«因等起» r c → W.«有漏無漏» c = .«有漏»))

/-- 【頌一乙】有 r、c：表色(r) 且 因等起(r，c) 且 見所斷(c) -/
def «頌一乙» (W : «世界») : Prop :=
  (∃ r c : W.E, («表色» W r ∧ W.«因等起» r c ∧ W.«斷非斷» c = .«見所斷»))

/-- 【求證】有覆無記・色 唯 初靜慮繫 -/
def «求證» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ W.«法類» x = .«色») → W.«繫不繫» x = .«初靜慮繫»))

end Kosa.M1
