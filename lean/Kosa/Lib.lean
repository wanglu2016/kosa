  (∀ x : W.E, (W.«界» x = .«色界» ↔ «色界繫» W x))

/-- 【界品56】無色界 即 無色界繫 -/
def «界品56» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«界» x = .«無色界» ↔ «無色界繫» W x))

/-- 【根品1】凡 x、y：相應(x，y) ⇔ 同所依(x，y) 且 同所緣(x，y) 且 同行相(x，y) 且 同時(x，y) -/
def «根品1» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y ↔ (W.«同所依» x y ∧ W.«同所緣» x y ∧ W.«同行相» x y ∧ W.«同時» x y)))

/-- 【根品2】凡 x：心(x) 且 染(x) ⇒ 有 y：癡(y) 且 相應(x，y) -/
def «根品2» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ «染» W x) → (∃ y : W.E, (W.«心所自性» y = .«癡» ∧ W.«相應» x y))))

/-- 【根品3】凡 x、y：相應(x，y) ⇒ 繫不繫(x)＝繫不繫(y) -/
def «根品3» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«繫不繫» x = W.«繫不繫» y))

/-- 【根品4】心心所・阿羅漢相續・最後剎那 非 等無間緣 -/
def «根品4» (W : «世界») : Prop :=
  (∀ x : W.E, ((«心心所» W x ∧ W.«阿羅漢相續» x ∧ W.«最後剎那» x) → ¬(W.«等無間緣» x)))

/-- 【根品5】凡 x、y：異熟果(x，y) ⇒ 不善(x) 或（善(x) 且 有漏(x)） -/
def «根品5» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«異熟果» x y → (W.«性» x = .«不善» ∨ (W.«性» x = .«善» ∧ W.«有漏無漏» x = .«有漏»))))

/-- 【根品6】凡 x、y：異熟果(x，y) ⇒ 無覆無記(y) -/
def «根品6» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«異熟果» x y → W.«性» y = .«無覆無記»))

/-- 【根品7】凡 x、y：等流果(x，y) ⇒ 性(x)＝性(y) 或（染(x) 且 染(y)） -/
def «根品7» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«等流果» x y → (W.«性» x = W.«性» y ∨ («染» W x ∧ «染» W y))))

/-- 【根品8】凡 x、y：離繫果(x，y) ⇒ 善(x) -/
def «根品8» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«離繫果» x y → W.«性» x = .«善»))

/-- 【根品9】凡 x、y：異熟果(x，y) 或 等流果(x，y) 或 士用果(x，y) 或 增上果(x，y) ⇒ 非（過去(y) 且（現在(x) 或 未來(x)））且 非（現在(y) 且 未來(x)） -/
def «根品9» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«異熟果» x y ∨ W.«等流果» x y ∨ W.«士用果» x y ∨ W.«增上果» x y) → (¬((W.«三世» y = .«過去» ∧ (W.«三世» x = .«現在» ∨ W.«三世» x = .«未來»))) ∧ ¬((W.«三世» y = .«現在» ∧ W.«三世» x = .«未來»)))))

/-- 【根品10】凡 x、y：異熟果(x，y) 或 等流果(x，y) ⇒ 非（現在(x) 且 現在(y)） -/
def «根品10» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«異熟果» x y ∨ W.«等流果» x y) → ¬((W.«三世» x = .«現在» ∧ W.«三世» y = .«現在»))))

/-- 【根品11】凡 x、y：等流果(x，y) ⇒ 非 未來(x) -/
def «根品11» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«等流果» x y → ¬(W.«三世» x = .«未來»)))

/-- 【根品12】凡 x、y：等流果(x，y) ⇒ 有漏無漏(x)＝有漏無漏(y) -/
