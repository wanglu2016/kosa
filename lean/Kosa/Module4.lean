def «二定以上» (W : «世界») (x : W.E) : Prop := (W.«繫不繫» x = .«第二靜慮繫» ∨ W.«繫不繫» x = .«第三靜慮繫» ∨ W.«繫不繫» x = .«第四靜慮繫» ∨ «無色界繫» W x)

/-- 本體公理：適用條件、關係的類型約束、對稱。 -/
structure «本體公理» (W : «世界») : Prop where
  «適用_色自性» : ∀ x : W.E, W.«色自性» x = .«—» ↔ ¬(W.«法類» x = .«色»)
  «適用_表非表» : ∀ x : W.E, W.«表非表» x = .«—» ↔ ¬((W.«色自性» x = .«色處» ∨ W.«色自性» x = .«聲處»))
  «適用_身表» : ∀ x : W.E, W.«表非表» x = .«身表» → W.«色自性» x = .«色處»
  «適用_語表» : ∀ x : W.E, W.«表非表» x = .«語表» → W.«色自性» x = .«聲處»
  «適用_心所自性» : ∀ x : W.E, W.«心所自性» x = .«—» ↔ ¬(W.«法類» x = .«心所»)
  «適用_見種» : ∀ x : W.E, W.«見種» x = .«—» ↔ ¬(W.«心所自性» x = .«慧»)
  «適用_性由» : ∀ x : W.E, W.«性由» x = .«—» ↔ ¬(¬(W.«性» x = .«無覆無記»))
  «適用_有伺無伺» : ∀ x : W.E, W.«有伺無伺» x = .«—» ↔ ¬(W.«法類» x = .«心»)
  «類型_相應» : ∀ x y : W.E, W.«相應» x y → («心心所» W x) ∧ («心心所» W y) ∧ x ≠ y
  «對稱_相應» : ∀ x y : W.E, W.«相應» x y → W.«相應» y x
  «類型_剎那等起» : ∀ x y : W.E, W.«剎那等起» x y → (W.«法類» x = .«色») ∧ (W.«法類» y = .«心») ∧ x ≠ y

/-- 【約一】無漏 即 不繫 -/
def «約一» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«有漏無漏» x = .«無漏» ↔ W.«繫不繫» x = .«不繫»))

/-- 【假一】心或心所或色 非 勝義成 -/
def «假一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∨ W.«法類» x = .«心所» ∨ W.«法類» x = .«色») → ¬(W.«性由» x = .«勝義成»)))

/-- 【假二】自性成 唯 心所 -/
def «假二» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性由» x = .«自性成» → W.«法類» x = .«心所»))

/-- 【假三】相應成 唯 心心所 -/
def «假三» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«性由» x = .«相應成» → «心心所» W x))

/-- 【假四】等起成・色 唯 業 -/
def «假四» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性由» x = .«等起成» ∧ W.«法類» x = .«色») → «業» W x))

/-- 【假五】無表色 唯 有記 -/
def «假五» (W : «世界») : Prop :=
  (∀ x : W.E, (W.«色自性» x = .«無表色» → «有記» W x))

/-- 【假六】凡 r：色(r) 且 等起成(r) ⇒ 有 c：剎那等起(r，c) 且 性(r)＝性(c) -/
def «假六» (W : «世界») : Prop :=
  (∀ r : W.E, ((W.«法類» r = .«色» ∧ W.«性由» r = .«等起成») → (∃ c : W.E, (W.«剎那等起» r c ∧ W.«性» r = W.«性» c))))

/-- 【假七】凡 r：表色(r) ⇒ 有 c：剎那等起(r，c) -/
def «假七» (W : «世界») : Prop :=
  (∀ r : W.E, («表色» W r → (∃ c : W.E, W.«剎那等起» r c)))

/-- 【假八】凡 r、c：剎那等起(r，c) ⇒ 繫不繫(r)＝繫不繫(c) -/
def «假八» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«繫不繫» r = W.«繫不繫» c))

/-- 【假九】凡 r、c：表色(r) 且 剎那等起(r，c) ⇒ 有伺(c) -/
def «假九» (W : «世界») : Prop :=
  (∀ r c : W.E, ((«表色» W r ∧ W.«剎那等起» r c) → W.«有伺無伺» c = .«有伺»))

/-- 【假十】二定以上・心 唯 無伺 -/
def «假十» (W : «世界») : Prop :=
  (∀ x : W.E, ((«二定以上» W x ∧ W.«法類» x = .«心») → W.«有伺無伺» x = .«無伺»))

/-- 【假十一】凡 r、c：剎那等起(r，c) ⇒ 有漏(c) -/
def «假十一» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → W.«有漏無漏» c = .«有漏»))

/-- 【假十二】凡 x：心(x) 且 染(x) ⇒ 有 y：癡(y) 且 相應(x，y) -/
def «假十二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«心» ∧ «染» W x) → (∃ y : W.E, (W.«心所自性» y = .«癡» ∧ W.«相應» x y))))

/-- 【假十三】凡 x、y：相應(x，y) ⇒ 性(x)＝性(y) -/
def «假十三» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«性» x = W.«性» y))

/-- 【假十四】凡 x、y：相應(x，y) ⇒ 繫不繫(x)＝繫不繫(y) -/
def «假十四» (W : «世界») : Prop :=
  (∀ x y : W.E, (W.«相應» x y → W.«繫不繫» x = W.«繫不繫» y))

/-- 【假十五】凡 y：惑(y) 且 欲界繫(y) 且 有覆無記(y) ⇒ 身見(y) 或 邊見(y) 或 （癡(y) 且 有 z：相應(y，z) 且 （身見(z) 或 邊見(z)）） -/
def «假十五» (W : «世界») : Prop :=
  (∀ y : W.E, ((«惑» W y ∧ W.«繫不繫» y = .«欲界繫» ∧ W.«性» y = .«有覆無記») → (W.«見種» y = .«身見» ∨ W.«見種» y = .«邊見» ∨ (W.«心所自性» y = .«癡» ∧ (∃ z : W.E, (W.«相應» y z ∧ (W.«見種» z = .«身見» ∨ W.«見種» z = .«邊見»)))))))

/-- 【假十六】惑 唯 所斷 -/
def «假十六» (W : «世界») : Prop :=
  (∀ x : W.E, («惑» W x → «所斷» W x))

/-- 【假十七】修所斷・惑 非 五見或疑 -/
def «假十七» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«斷非斷» x = .«修所斷» ∧ «惑» W x) → ¬((«五見» W x ∨ W.«心所自性» x = .«疑»))))

/-- 【假十八】凡 x、y：相應(x，y) 且 惑(y) 且 見所斷(y) ⇒ 見所斷(x) -/
def «假十八» (W : «世界») : Prop :=
  (∀ x y : W.E, ((W.«相應» x y ∧ «惑» W y ∧ W.«斷非斷» y = .«見所斷») → W.«斷非斷» x = .«見所斷»))

/-- 【假十九】凡 r、c：剎那等起(r，c) ⇒ 非 見所斷(c) -/
def «假十九» (W : «世界») : Prop :=
  (∀ r c : W.E, (W.«剎那等起» r c → ¬(W.«斷非斷» c = .«見所斷»)))

/-- 【定一】色・非無覆無記 唯 等起成 -/
def «定一» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«色» ∧ ¬(W.«性» x = .«無覆無記»)) → W.«性由» x = .«等起成»))

/-- 【定二】色・非無覆無記 唯 業 -/
def «定二» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«法類» x = .«色» ∧ ¬(W.«性» x = .«無覆無記»)) → «業» W x))

/-- 【定三】有覆無記・色 唯 表色 -/
def «定三» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ W.«法類» x = .«色») → «表色» W x))

/-- 【定四】五見 唯 見所斷 -/
def «定四» (W : «世界») : Prop :=
  (∀ x : W.E, («五見» W x → W.«斷非斷» x = .«見所斷»))

/-- 【定五】欲界繫・有覆無記・心 唯 見所斷 -/
def «定五» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«繫不繫» x = .«欲界繫» ∧ W.«性» x = .«有覆無記» ∧ W.«法類» x = .«心») → W.«斷非斷» x = .«見所斷»))

/-- 【定六】欲界繫・有覆無記・表色 無 -/
def «定六» (W : «世界») : Prop :=
  ¬((∃ x : W.E, (W.«繫不繫» x = .«欲界繫» ∧ W.«性» x = .«有覆無記» ∧ «表色» W x)))

/-- 【定七】表色 唯 欲界繫或初靜慮繫 -/
def «定七» (W : «世界») : Prop :=
  (∀ x : W.E, («表色» W x → (W.«繫不繫» x = .«欲界繫» ∨ W.«繫不繫» x = .«初靜慮繫»)))

/-- 【定七乙】有覆無記・表色 唯 欲界繫或初靜慮繫 -/
def «定七乙» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ «表色» W x) → (W.«繫不繫» x = .«欲界繫» ∨ W.«繫不繫» x = .«初靜慮繫»)))

/-- 【定八】有覆無記・表色 唯 初靜慮繫 -/
def «定八» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ «表色» W x) → W.«繫不繫» x = .«初靜慮繫»))

/-- 【目標】有覆無記・色 唯 初靜慮繫 -/
def «目標» (W : «世界») : Prop :=
  (∀ x : W.E, ((W.«性» x = .«有覆無記» ∧ W.«法類» x = .«色») → W.«繫不繫» x = .«初靜慮繫»))

end Kosa.M4
